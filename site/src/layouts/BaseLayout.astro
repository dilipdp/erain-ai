---
const {
  title = 'EraIn AI — Intelligence That Runs Your Business',
  description =
    'EraIn builds execution-grade AI systems that audit reality, guide decisions, and drive measurable business outcomes. Start with EraIn Audit AI™.',
  /**
   * Layout controls (optional):
   * - mainPadding: 'default' | 'tight' | 'none'
   * - pageClass: extra class appended to the page wrapper
   */
  mainPadding = 'default',
  pageClass = '',
} = Astro.props;

const site = (import.meta.env.SITE || 'https://erainai.com').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, site).href;
const isDev = !!import.meta.env.DEV;

const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "EraIn AI",
  url: site,
  logo: `${site}/logo.svg`,
  sameAs: [],
});

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "EraIn AI",
  url: site,
});

const currentPath = Astro.url.pathname;
const isActive = (path) => currentPath === path;
const isResultsActive = currentPath === '/results' || currentPath === '/sample-report';
const isDevelopersActive = currentPath === '/developers' || currentPath === '/developer-docs';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#08142f" />
    <meta name="robots" content="index,follow" />
    <meta name="color-scheme" content="light" />
    <meta property="og:locale" content="en_US" />

    <script type="application/ld+json" is:inline>{orgJsonLd}</script>
    <script type="application/ld+json" is:inline>{websiteJsonLd}</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EraIn AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.png`} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <style is:global>
      :root {
        /* Brand */
        --primary: #0f172a;
        --secondary: #1e2f56;
        --accent: #245adf;
        --accent-2: #0a8cb8;

        /* Neutrals */
        --bg: #f5f1e8;
        --surface: rgba(255, 255, 255, 0.88);
        --surface-2: rgba(15, 23, 42, 0.035);
        --border: rgba(15, 23, 42, 0.14);
        --muted: rgba(15, 23, 42, 0.66);
        --muted-2: rgba(15, 23, 42, 0.8);
        --bg-grid: rgba(15, 23, 42, 0.018);

        /* Radius / shadow */
        --radius-lg: 22px;
        --radius-md: 16px;
        --radius-sm: 12px;
        --shadow-sm: 0 1px 2px rgba(2, 6, 23, 0.06);
        --shadow-md: 0 16px 44px rgba(2, 10, 32, 0.14);
        --shadow-lg: 0 28px 68px rgba(2, 10, 32, 0.18);

        /* Layout */
        /* Wider, more “premium” use of space on large screens while keeping safe gutters. */
        --container: min(1480px, 94vw);
        --gutter: clamp(18px, 3vw, 32px);
        --safe-bottom: env(safe-area-inset-bottom, 0px);
        --safe-left: env(safe-area-inset-left, 0px);
        --safe-right: env(safe-area-inset-right, 0px);

        /* Typography */
        --text: rgba(2, 6, 23, 0.92);
        --text-soft: rgba(17, 24, 39, 0.78);
        --text-size: 16px;
        --leading: 1.62;
        --measure: 78ch;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        max-width: 100%;
        overflow-x: hidden; /* prevent sideways scroll while we harden width constraints */
      }

      /* Ensure flex/grid children can shrink instead of forcing horizontal overflow */
      :where(main, section, article, .container, .page, .card, .tier) {
        min-width: 0;
      }

      :where(img, video, canvas, svg) {
        max-width: 100%;
        height: auto;
      }

      body {
        margin: 0;
        font-family: Manrope, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: var(--text-size);
        color: var(--text);
        line-height: var(--leading);
        -webkit-text-size-adjust: 100%;
        background:
          radial-gradient(860px 420px at 6% -14%, rgba(36, 90, 223, 0.12), transparent 62%),
          radial-gradient(760px 320px at 98% -12%, rgba(10, 140, 184, 0.11), transparent 66%),
          linear-gradient(180deg, #faf7f2 0%, #f5f1e8 42%, #f8f4ec 100%);
        background-color: var(--bg);
        background-attachment: fixed;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: geometricPrecision;
        position: relative;
        min-height: 100vh;
      }

      body::before,
      body::after {
        content: "";
        position: fixed;
        pointer-events: none;
        z-index: 0;
      }

      body::before {
        inset: 0;
        background-image:
          linear-gradient(to right, var(--bg-grid) 1px, transparent 1px),
          linear-gradient(to bottom, var(--bg-grid) 1px, transparent 1px);
        background-size: 68px 68px;
        mask-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.2), transparent 80%);
      }

      body::after {
        width: 52vw;
        height: 52vw;
        right: -18vw;
        top: -16vw;
        border-radius: 999px;
        background:
          radial-gradient(circle at 34% 34%, rgba(36, 90, 223, 0.14), rgba(36, 90, 223, 0.02) 46%, transparent 74%);
        filter: blur(8px);
      }

      body > header,
      body > main,
      body > footer {
        position: relative;
        z-index: 0;
      }

      :where(h1, h2, h3, .h1, .h2, .kicker, .nav-links a, .brand, .btn) {
        font-family: Manrope, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      :where(.displaySerif, .sectionSerif) {
        font-family: "Instrument Serif", Georgia, "Times New Roman", serif;
      }

      ::selection { background: rgba(37, 99, 235, 0.18); }

      a {
        color: var(--accent);
        text-decoration: none;
        text-underline-offset: 3px;
      }
      a:hover { text-decoration: underline; }

      :focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.22);
        outline-offset: 2px;
        border-radius: 10px;
      }

      .container {
        max-width: var(--container);
        margin: 0 auto;
        padding-left: var(--gutter);
        padding-right: var(--gutter);
      }

      /* Full-bleed helper when a page/section truly needs edge-to-edge */
      .containerFull {
        width: 100%;
        max-width: none;
        margin: 0;
        padding-left: var(--gutter);
        padding-right: var(--gutter);
      }

      .skipLink {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 120;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid rgba(11, 31, 66, 0.2);
        background: rgba(255, 255, 255, 0.95);
        color: var(--primary);
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 14px 28px rgba(2, 10, 32, 0.14);
        transform: translateY(-160%);
        transition: transform 180ms ease;
      }

      .skipLink:focus-visible {
        transform: translateY(0);
      }

      /* ---------- Header / Nav (stable alignment) ---------- */
      header {
        position: sticky;
        top: 0;
        z-index: 10000 !important;
        isolation: isolate;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        background: rgba(250, 248, 244, 0.86);
        border-bottom: 1px solid rgba(15, 23, 42, 0.1);
        transition: background 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      header.scrolled {
        background: rgba(252, 250, 246, 0.95);
        border-bottom-color: rgba(15, 23, 42, 0.14);
        box-shadow: 0 8px 24px rgba(2, 10, 32, 0.08);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 72px;
        position: relative;
        z-index: 2;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--primary);
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .brand img { display: block; }

      .logo-full { height: 28px; display: block !important; }
      .logo-mark { height: 28px; display: none !important; }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .nav-links a {
        color: rgba(15, 23, 42, 0.74);
        font-weight: 680;
        font-size: 14px;
        padding: 9px 12px;
        border-radius: 12px;
        border: 1px solid transparent;
        transition: background 150ms ease, color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
      }

      .nav-links a:hover {
        background: rgba(255, 255, 255, 0.72);
        border-color: rgba(15, 23, 42, 0.12);
        box-shadow: 0 8px 20px rgba(2, 10, 32, 0.08);
        color: var(--secondary);
        text-decoration: none;
      }

      .nav-links a.active {
        color: var(--secondary);
        background: rgba(255, 255, 255, 0.8);
        border-color: rgba(15, 23, 42, 0.14);
        box-shadow: 0 8px 18px rgba(2, 10, 32, 0.08);
      }

      .nav-links a.cta {
        padding: 10px 14px;
        background: linear-gradient(135deg, #245adf 0%, #0a8cb8 100%);
        color: #fff;
        border-radius: 14px;
        font-weight: 760;
        line-height: 1;
        white-space: nowrap;
        box-shadow: 0 12px 26px rgba(36, 90, 223, 0.24);
        border: 1px solid rgba(255, 255, 255, 0.28);
      }

      .nav-links a.cta:hover {
        text-decoration: none;
        box-shadow: 0 14px 30px rgba(2, 6, 23, 0.16);
      }

      .menu-toggle {
        display: none;
        font-size: 20px;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--primary);
        position: relative;
        z-index: 10002 !important;
        padding: 10px 12px;
        border-radius: 12px;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }

      .menu-toggle:active {
        transform: scale(0.98);
      }

      @media (max-width: 768px) {
        .nav-links {
          display: none;
          position: fixed;
          top: 72px;
          right: 12px;
          left: 12px;
          bottom: auto;
          background: rgba(255, 255, 255, 0.94);
          border: 1px solid var(--border);
          border-radius: 16px;
          box-shadow: var(--shadow-md);
          padding: 14px;
          flex-direction: column;
          align-items: stretch;
          gap: 10px;
          z-index: 10001 !important;
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          transform-origin: top right;
          transform: translateY(-6px) scale(0.98);
          opacity: 0;
          pointer-events: none;
          transition: transform 160ms ease, opacity 160ms ease;
        }

        .nav-links.open {
          display: flex;
          transform: translateY(0) scale(1);
          opacity: 1;
          pointer-events: auto;
        }

        .menu-toggle { display: block; z-index: 10002 !important; }
        .logo-full { display: none !important; }
        .logo-mark { display: block !important; }

        .nav-links a { margin: 0; padding: 12px 12px; border-radius: 14px; }
      }

      /* ---------- Main / Footer ---------- */
      /* Make layout resilient even when pages include their own containers */
      main.main { padding: 64px 0; }
      main.mainTight { padding: 40px 0; }
      main.mainNoPad { padding: 0; }
      .page {
        padding: 0;
        width: 100%;
        min-width: 0;
        overflow-x: clip;
      }

      footer {
        border-top: 1px solid var(--border);
        margin-top: 72px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(248, 243, 235, 0.92));
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }

      .footer {
        max-width: var(--container);
        margin: 0 auto;
        padding: 34px var(--gutter);
        font-size: 14px;
        color: rgba(15, 23, 42, 0.72);
        display: grid;
        gap: 18px;
      }

      .footerTop {
        display: grid;
        gap: 18px;
        grid-template-columns: 1fr;
      }

      .footerBrand {
        display: grid;
        gap: 8px;
      }

      .footerBrandLine {
        color: rgba(15, 23, 42, 0.92);
        font-size: 16px;
        font-weight: 780;
      }

      .footerTagline {
        color: rgba(15, 23, 42, 0.66);
        font-size: 14px;
      }

      .footerLinks {
        display: grid;
        gap: 14px;
        grid-template-columns: 1fr;
      }

      .footerLinkGroup {
        display: grid;
        gap: 8px;
        align-content: start;
      }

      .footerLinkK {
        color: rgba(15, 23, 42, 0.56);
        font-size: 10px;
        font-weight: 860;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .footerLinks a {
        color: rgba(15, 23, 42, 0.78);
        font-size: 14px;
        font-weight: 630;
        text-decoration: none;
        width: fit-content;
      }

      .footerLinks a:hover {
        color: #1f4dc4;
        text-decoration: underline;
      }

      .footerMeta {
        color: rgba(15, 23, 42, 0.58);
        font-size: 13px;
      }

      @media (min-width: 920px) {
        .footerTop {
          grid-template-columns: 1.1fr 1.9fr;
          align-items: start;
        }
      }

      @media (min-width: 720px) {
        .footerLinks {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .cookieBanner {
        position: fixed;
        left: max(12px, var(--safe-left));
        right: max(12px, var(--safe-right));
        bottom: calc(12px + var(--safe-bottom));
        z-index: 85;
        max-width: 920px;
        margin: 0 auto;
        border: 1px solid rgba(11, 31, 66, 0.2);
        border-radius: 18px;
        background: rgba(248, 252, 255, 0.96);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 18px 44px rgba(2, 10, 32, 0.18);
        padding: 12px;
        display: grid;
        gap: 10px;
        transition: transform 220ms ease, opacity 220ms ease;
      }

      .cookieBanner.hidden {
        opacity: 0;
        pointer-events: none;
        transform: translateY(24px);
      }

      .cookieBannerBody {
        color: rgba(17, 24, 39, 0.76);
        font-size: 13px;
        line-height: 1.62;
      }

      .cookieBannerTitle {
        color: rgba(7, 20, 48, 0.9);
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 880;
      }

      .cookieBannerBody p {
        margin: 6px 0 0;
      }

      .cookieBannerActions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .cookieBannerActions .btn {
        padding: 10px 14px;
      }

      @media (max-width: 768px) {
        body {
          padding-bottom: calc(18px + var(--safe-bottom));
        }

        .cookieBanner {
          bottom: calc(14px + var(--safe-bottom));
        }
      }

      /* ---------- Content typography: opt-in only ---------- */
      /* Use .content when you want readable long-form text measure */
      .content {
        max-width: var(--measure);
        margin-left: auto;
        margin-right: auto;
      }

      /* Use .prose when you want the typography rules but NOT the narrow measure */
      .prose {
        max-width: none;
      }

      .content :where(h1, h2, h3) {
        color: var(--primary);
        letter-spacing: -0.02em;
        margin: 0;
      }

      .prose :where(h1, h2, h3) {
        color: var(--primary);
        letter-spacing: -0.02em;
        margin: 0;
      }

      .prose :where(h1) {
        font-size: clamp(34px, 3.6vw, 54px);
        line-height: 1.06;
        letter-spacing: -0.03em;
        font-weight: 900;
        margin-bottom: 10px;
      }

      .prose :where(h2) {
        font-size: 24px;
        line-height: 1.25;
        letter-spacing: -0.02em;
        font-weight: 800;
        margin: 24px 0 10px;
      }

      .prose :where(h3) {
        font-size: 18px;
        line-height: 1.35;
        letter-spacing: -0.01em;
        font-weight: 700;
        margin: 18px 0 8px;
      }

      .prose :where(p) {
        margin: 12px 0 0;
        font-size: 16px;
        line-height: 1.85;
        color: var(--muted-2);
      }

      .prose :where(ul, ol) {
        margin: 12px 0 0;
        padding-left: 20px;
        color: rgba(17, 24, 39, 0.76);
      }

      .prose :where(li) { margin: 6px 0; line-height: 1.8; }

      .prose :where(hr) {
        border: 0;
        height: 1px;
        background: rgba(17, 24, 39, 0.08);
        margin: 22px 0;
      }

      .prose :where(code) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.95em;
        background: rgba(2, 6, 23, 0.04);
        border: 1px solid rgba(2, 6, 23, 0.06);
        padding: 2px 6px;
        border-radius: 8px;
      }

      .prose :where(pre) {
        overflow: auto;
        padding: 14px;
        border-radius: 16px;
        border: 1px solid rgba(2, 6, 23, 0.08);
        background: rgba(255, 255, 255, 0.92);
        box-shadow: var(--shadow-sm);
      }

      .prose :where(pre code) { background: transparent; border: none; padding: 0; }

      .prose :where(blockquote) {
        margin: 14px 0 0;
        padding: 12px 14px;
        border-left: 4px solid rgba(37, 99, 235, 0.35);
        background: rgba(37, 99, 235, 0.06);
        border-radius: 14px;
        color: rgba(17, 24, 39, 0.74);
      }

      .content :where(h1) {
        font-size: clamp(34px, 3.6vw, 54px);
        line-height: 1.06;
        letter-spacing: -0.03em;
        font-weight: 900;
        margin-bottom: 10px;
      }

      .content :where(h2) {
        font-size: 24px;
        line-height: 1.25;
        letter-spacing: -0.02em;
        font-weight: 800;
        margin: 24px 0 10px;
      }

      .content :where(h3) {
        font-size: 18px;
        line-height: 1.35;
        letter-spacing: -0.01em;
        font-weight: 700;
        margin: 18px 0 8px;
      }

      .content :where(p) {
        margin: 12px 0 0;
        font-size: 16px;
        line-height: 1.85;
        color: var(--muted-2);
      }

      .content :where(ul, ol) {
        margin: 12px 0 0;
        padding-left: 20px;
        color: rgba(17, 24, 39, 0.76);
      }

      .content :where(li) { margin: 6px 0; line-height: 1.8; }

      .content :where(hr) {
        border: 0;
        height: 1px;
        background: rgba(17, 24, 39, 0.08);
        margin: 22px 0;
      }

      .content :where(code) {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.95em;
        background: rgba(2, 6, 23, 0.04);
        border: 1px solid rgba(2, 6, 23, 0.06);
        padding: 2px 6px;
        border-radius: 8px;
      }

      .content :where(pre) {
        overflow: auto;
        padding: 14px;
        border-radius: 16px;
        border: 1px solid rgba(2, 6, 23, 0.08);
        background: rgba(255, 255, 255, 0.92);
        box-shadow: var(--shadow-sm);
      }
      .content :where(pre code) { background: transparent; border: none; padding: 0; }

      .content :where(blockquote) {
        margin: 14px 0 0;
        padding: 12px 14px;
        border-left: 4px solid rgba(37, 99, 235, 0.35);
        background: rgba(37, 99, 235, 0.06);
        border-radius: 14px;
        color: rgba(17, 24, 39, 0.74);
      }

      /* ---------- Shared UI System (keep your API stable) ---------- */
      .section { padding: 28px 0; }
      .section + .section { border-top: 1px solid rgba(17, 24, 39, 0.06); }

      .kicker {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(17, 24, 39, 0.62);
      }

      .h1 {
        margin: 10px 0 0;
        font-size: clamp(34px, 3.6vw, 54px);
        line-height: 1.05;
        font-weight: 900;
        color: var(--primary);
        letter-spacing: -0.03em;
      }

      .h2 {
        margin: 0;
        font-size: 22px;
        line-height: 1.25;
        font-weight: 800;
        color: var(--primary);
        letter-spacing: -0.02em;
      }

      .lead {
        margin: 14px 0 0;
        font-size: 18px;
        line-height: 1.85;
        color: rgba(17, 24, 39, 0.72);
        max-width: 72ch;
      }

      .muted { color: rgba(17, 24, 39, 0.64); }

      .badgeRow { display: flex; gap: 10px; flex-wrap: wrap; margin: 0 0 14px; }
      .badge {
        font-size: 12px;
        font-weight: 800;
        color: var(--primary);
        border: 1px solid rgba(16, 24, 40, 0.14);
        background: rgba(255, 255, 255, 0.86);
        padding: 6px 10px;
        border-radius: 999px;
      }
      .badgeSoft { color: #334155; background: rgba(16, 24, 40, 0.04); }

      .card {
        border: 1px solid var(--border);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.82));
        border-radius: 22px;
        padding: 22px;
        box-shadow: var(--shadow-sm), 0 20px 42px rgba(2, 10, 32, 0.09);
      }
      .cardSoft { background: rgba(16, 24, 40, 0.03); }
      .cardPro { border-color: rgba(37, 99, 235, 0.26); background: rgba(37, 99, 235, 0.06); }

      .grid { display: grid; gap: 18px; }
      .grid2 { display: grid; gap: 14px; grid-template-columns: 1fr; }
      @media (min-width: 720px) { .grid2 { grid-template-columns: 1fr 1fr; } }

      /* ---------- Pricing layout guardrails ---------- */
      :where(.tiers, .pricingTiers, .pricingGrid, .tierGrid) {
        width: 100%;
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      }

      :where(.tier) {
        width: 100%;
        min-width: 0;
        max-width: 100%;
      }

      /* Prevent big headings/prices from clipping on narrow screens */
      :where(.tier h1, .tier h2, .tier h3, .tier .price, .tier .amount) {
        max-width: 100%;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
        margin-top: 6px;
      }
      @media (min-width: 640px) {
        .actions { flex-direction: row; align-items: center; gap: 14px; }
      }

      .btn {
        border-radius: 15px;
        padding: 12px 18px;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(11, 31, 66, 0.14);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.78));
        color: var(--primary);
        box-shadow: 0 14px 24px rgba(2, 10, 32, 0.08);
        transition: transform 140ms ease, box-shadow 140ms ease, background 140ms ease, border-color 140ms ease, filter 140ms ease;
        text-decoration: none;
        white-space: nowrap;
      }
      .btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
        box-shadow: 0 24px 36px rgba(2, 10, 32, 0.14);
        border-color: rgba(11, 31, 66, 0.2);
        filter: saturate(1.03);
      }

      .btnPrimary {
        background: linear-gradient(135deg, #245adf 0%, #0a8cb8 100%);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.3);
        box-shadow: 0 16px 30px rgba(36, 90, 223, 0.24);
      }
      .btnPrimary:hover { box-shadow: 0 20px 38px rgba(36, 90, 223, 0.3); }

      .btnGhost { background: transparent; box-shadow: none; }

      .divider { height: 1px; background: rgba(17, 24, 39, 0.08); border: 0; }

      .reveal {
        opacity: 0;
        transform: translateY(16px) scale(0.99);
        transition:
          opacity 520ms cubic-bezier(0.22, 1, 0.36, 1),
          transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
        will-change: transform, opacity;
      }

      .reveal.in {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      @media (prefers-reduced-motion: reduce) {
        * { scroll-behavior: auto !important; }
        .btn, .nav-links a { transition: none !important; }
        .reveal, .reveal.in {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        body {
          background-attachment: scroll;
        }
        body::before,
        body::after {
          display: none;
        }
      }
    </style>
  </head>

  <body data-dev={isDev ? '1' : '0'}>
    <a href="#main-content" class="skipLink">Skip to main content</a>
    <header>
      <nav class="nav container">
        <a href="/" class="brand" aria-label="EraIn AI">
          <img class="logo-full" src="/logo.svg" alt="EraIn AI" />
          <img class="logo-mark" src="/logo-mark.svg" alt="EraIn AI" />
        </a>

        <button
          id="menuBtn"
          type="button"
          class="menu-toggle"
          aria-label="Toggle menu"
          aria-controls="navLinks"
          aria-expanded="false"
        >☰</button>

        <div class="nav-links" id="navLinks">
          <a href="/solutions" class={isActive('/solutions') ? 'active' : ''} aria-current={isActive('/solutions') ? 'page' : undefined}>Solutions</a>
          <a href="/use-cases" class={isActive('/use-cases') ? 'active' : ''} aria-current={isActive('/use-cases') ? 'page' : undefined}>Use Cases</a>
          <a href="/industries" class={isActive('/industries') ? 'active' : ''} aria-current={isActive('/industries') ? 'page' : undefined}>Industries</a>
          <a href="/pricing" class={isActive('/pricing') ? 'active' : ''} aria-current={isActive('/pricing') ? 'page' : undefined}>Pricing</a>
          <a href="/results" class={isResultsActive ? 'active' : ''} aria-current={isResultsActive ? 'page' : undefined}>Results</a>
          <a href="/about" class={isActive('/about') ? 'active' : ''} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
          <a href="/developers" class={isDevelopersActive ? 'active' : ''} aria-current={isDevelopersActive ? 'page' : undefined}>Developers</a>
          <a href="/contact" class={isActive('/contact') ? 'active' : ''} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
          <a href="/request-assessment" class={`cta ${isActive('/request-assessment') ? 'active' : ''}`} aria-current={isActive('/request-assessment') ? 'page' : undefined}>Start Free AI Audit</a>
        </div>
      </nav>
    </header>

    <main
      id="main-content"
      tabindex="-1"
      class={
        mainPadding === 'none'
          ? 'main mainNoPad'
          : mainPadding === 'tight'
            ? 'main mainTight'
            : 'main'
      }
    >
      <div class="container">
        <!-- IMPORTANT: keep BaseLayout neutral; pages can opt-in to .content/.prose typography if needed -->
        <div class={`page ${pageClass}`.trim()}>
          <slot />
        </div>
      </div>
    </main>

    <footer>
      <div class="footer">
        <div class="footerTop">
          <div class="footerBrand">
            <div class="footerBrandLine"><strong>EraIn AI</strong> - Intelligence that runs business execution</div>
            <div class="footerTagline">Auditability, decision governance, and measurable ROI attribution.</div>
          </div>
          <div class="footerLinks" aria-label="Footer actions">
            <div class="footerLinkGroup">
              <div class="footerLinkK">Explore</div>
              <a href="/request-assessment">Start Free AI Audit</a>
              <a href="/results">View Results</a>
              <a href="/client-login">Client Login</a>
              <a href="/use-cases">Use Cases</a>
              <a href="/about">About</a>
              <a href="/pricing">Pricing</a>
              <a href="/contact">Contact</a>
            </div>
            <div class="footerLinkGroup">
              <div class="footerLinkK">Company</div>
              <a href="/careers">Careers</a>
              <a href="/events">Events</a>
              <a href="/tutorials">Tutorials</a>
              <a href="/engineering">Engineering</a>
              <a href="/developer-docs">Developer Docs</a>
            </div>
            <div class="footerLinkGroup">
              <div class="footerLinkK">Trust</div>
              <a href="/legal">Legal</a>
              <a href="/security">Security</a>
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
              <a href="/dpa">DPA</a>
              <a href="/cookie-policy">Cookies</a>
            </div>
          </div>
        </div>
        <div class="footerMeta">Email: hello@erainai.com</div>
      </div>
    </footer>

    <div class="cookieBanner hidden" id="cookieBanner" role="dialog" aria-label="Cookie preferences" aria-live="polite">
      <div class="cookieBannerBody">
        <div class="cookieBannerTitle">Cookie preferences</div>
        <p>
          We use essential cookies for site operation and optional analytics cookies to improve performance and conversion quality.
          Review details in our <a href="/cookie-policy">Cookie Policy</a>.
        </p>
      </div>
      <div class="cookieBannerActions" aria-label="Cookie actions">
        <button type="button" class="btn" id="cookieEssentialBtn">Essential only</button>
        <button type="button" class="btn btnPrimary" id="cookieAcceptBtn">Accept analytics</button>
      </div>
    </div>

    <script is:inline>
      (function () {
        function $(id) { return document.getElementById(id); }
        const prefersReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const CONSENT_KEY = "erain_cookie_consent_v1";
        const CONSENT_GRANTED = "granted";
        const CONSENT_ESSENTIAL = "essential";

        const parseConsent = (value) => {
          if (value === CONSENT_GRANTED || value === CONSENT_ESSENTIAL) return value;
          return "";
        };

        const banner = $("cookieBanner");
        const btnEssential = $("cookieEssentialBtn");
        const btnAccept = $("cookieAcceptBtn");

        let consentState = "";
        try {
          consentState = parseConsent(localStorage.getItem(CONSENT_KEY) || "");
        } catch (_) {
          consentState = "";
        }

        const setBannerVisibility = (show) => {
          if (!banner) return;
          banner.classList.toggle("hidden", !show);
          document.body.classList.toggle("cookieBannerVisible", show);
        };

        const analyticsAllowed = () => consentState === CONSENT_GRANTED;
        try {
          window.erainAnalyticsEnabled = analyticsAllowed();
        } catch (_) {}
        const emitAnalyticsEvent = (eventName, payload = {}) => {
          if (!analyticsAllowed()) return false;
          try {
            if (window.gtag) {
              window.gtag("event", eventName, payload);
            }
          } catch (_) {}
          try {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: eventName, ...payload });
          } catch (_) {}
          return true;
        };
        try {
          window.erainTrack = emitAnalyticsEvent;
        } catch (_) {}

        const saveConsent = (nextState, source) => {
          consentState = parseConsent(nextState);
          if (!consentState) return;
          try {
            window.erainAnalyticsEnabled = analyticsAllowed();
          } catch (_) {}
          try {
            localStorage.setItem(CONSENT_KEY, consentState);
          } catch (_) {}

          setBannerVisibility(false);

          if (analyticsAllowed()) {
            window.dispatchEvent(new CustomEvent("erain-consent-granted", { detail: { source } }));
            emitAnalyticsEvent("site_cookie_consent_granted", {
              source,
              page_path: window.location.pathname,
            });
          } else {
            window.dispatchEvent(new CustomEvent("erain-consent-essential", { detail: { source } }));
          }
        };

        try {
          const cookiesOpen = new URL(window.location.href).searchParams.get("cookies") === "open";
          setBannerVisibility(cookiesOpen || !consentState);
        } catch (_) {
          setBannerVisibility(!consentState);
        }

        try {
          btnEssential?.addEventListener("click", () => saveConsent(CONSENT_ESSENTIAL, "banner"));
          btnAccept?.addEventListener("click", () => saveConsent(CONSENT_GRANTED, "banner"));
        } catch (_) {}

        // Mobile menu: accessible toggle + close on outside click / Escape / link click
        try {
          const btn = $("menuBtn");
          const links = $("navLinks");
          if (btn && links) {
            const isOpen = () => links.classList.contains("open");
            const setExpanded = (v) => btn.setAttribute("aria-expanded", v ? "true" : "false");
            const open = () => { links.classList.add("open"); setExpanded(true); };
            const close = () => { links.classList.remove("open"); setExpanded(false); };
            const toggle = () => (isOpen() ? close() : open());

            btn.addEventListener("click", (e) => { e.preventDefault(); toggle(); });
            window.addEventListener("resize", () => {
              if (window.innerWidth > 768 && isOpen()) close();
            });

            document.addEventListener("click", (e) => {
              if (!isOpen()) return;
              const t = e.target;
              if (!(t instanceof Node)) return;
              if (links.contains(t) || btn.contains(t)) return;
              close();
            });

            document.addEventListener("keydown", (e) => {
              if (e.key === "Escape" && isOpen()) close();
            });

            links.addEventListener("click", (e) => {
              const t = e.target;
              if (!(t instanceof HTMLElement)) return;
              if (t.closest("a")) close();
            });
          }
        } catch (_) {}

        // Header refinement on scroll for premium depth
        try {
          const header = document.querySelector("header");
          if (header) {
            const onScroll = () => {
              header.classList.toggle("scrolled", window.scrollY > 8);
            };
            onScroll();
            window.addEventListener("scroll", onScroll, { passive: true });
          }
        } catch (_) {}

        // Core telemetry: page view + web vitals envelope
        try {
          const shared = {
            page_path: window.location.pathname,
            page_title: document.title,
            viewport: `${window.innerWidth}x${window.innerHeight}`,
            language: navigator.language || "unknown",
          };
          let pageViewSent = false;
          const sendPageView = () => {
            if (pageViewSent) return;
            const emitted = emitAnalyticsEvent("site_page_view", shared);
            if (emitted) {
              pageViewSent = true;
            }
          };
          sendPageView();

          const sendVital = (name, value) => {
            if (!Number.isFinite(value)) return;
            emitAnalyticsEvent("site_web_vital", {
              metric_name: name,
              metric_value: Number(value.toFixed(2)),
              ...shared,
            });
          };

          try {
            const navEntry = performance.getEntriesByType("navigation")[0];
            if (navEntry && typeof navEntry.responseStart === "number") {
              sendVital("TTFB", navEntry.responseStart);
            }
          } catch (_) {}

          let clsValue = 0;
          let lcpValue = null;
          let inpValue = 0;
          let flushedVitals = false;

          const flushVitals = () => {
            if (flushedVitals) return;
            flushedVitals = true;
            sendVital("CLS", clsValue);
            if (lcpValue !== null) sendVital("LCP", lcpValue);
            if (inpValue > 0) sendVital("INP", inpValue);
          };

          if ("PerformanceObserver" in window) {
            try {
              const poPaint = new PerformanceObserver((list) => {
                for (const entry of list.getEntries()) {
                  if (entry.name === "first-contentful-paint") {
                    sendVital("FCP", entry.startTime);
                    poPaint.disconnect();
                    break;
                  }
                }
              });
              poPaint.observe({ type: "paint", buffered: true });
            } catch (_) {}

            try {
              const poLcp = new PerformanceObserver((list) => {
                const entries = list.getEntries();
                const lastEntry = entries[entries.length - 1];
                if (lastEntry) lcpValue = lastEntry.startTime;
              });
              poLcp.observe({ type: "largest-contentful-paint", buffered: true });
            } catch (_) {}

            try {
              const poCls = new PerformanceObserver((list) => {
                for (const entry of list.getEntries()) {
                  if (!entry.hadRecentInput) {
                    clsValue += entry.value;
                  }
                }
              });
              poCls.observe({ type: "layout-shift", buffered: true });
            } catch (_) {}

            try {
              const poInp = new PerformanceObserver((list) => {
                for (const entry of list.getEntries()) {
                  if (entry.duration > inpValue) {
                    inpValue = entry.duration;
                  }
                }
              });
              poInp.observe({ type: "event", buffered: true, durationThreshold: 40 });
            } catch (_) {}
          }

          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "hidden") flushVitals();
          });
          window.addEventListener("pagehide", flushVitals);
          window.addEventListener("erain-consent-granted", () => {
            sendPageView();
          });
        } catch (_) {}

        // Launch telemetry for core conversion interactions
        try {
          const trackableTargets = [
            "/request-assessment",
            "/sample-report",
            "/sample-report.pdf",
            "/results",
            "/contact",
            "/pricing",
            "/client-login"
          ];

          document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const anchor = target.closest("a");
            if (!(anchor instanceof HTMLAnchorElement)) return;

            const hrefRaw = anchor.getAttribute("href") || "";
            if (!hrefRaw || hrefRaw.startsWith("mailto:") || hrefRaw.startsWith("tel:")) return;
            const isTracked = trackableTargets.some((prefix) => hrefRaw.startsWith(prefix));
            if (!isTracked) return;

            const label = anchor.dataset.track || anchor.textContent?.trim() || hrefRaw;
            const eventName = "site_cta_click";
            const payload = {
              cta_label: label,
              href: hrefRaw,
              page_path: window.location.pathname,
            };
            emitAnalyticsEvent(eventName, payload);
          }, { passive: true });
        } catch (_) {}

        // Unified reveal animation across premium surfaces
        try {
          if (prefersReducedMotion) return;

          const selectors = [
            ".hero",
            ".heroPanel",
            ".solHero",
            ".card",
            ".trustCard",
            ".trustItem",
            ".heroSub",
            ".heroMeta",
            ".enterpriseStrip",
            ".solStep",
            ".solCard",
            ".tier",
            ".afterCard",
            ".closingCard",
            ".enterpriseItem",
            ".legalCard",
            ".legalWide",
            ".trustHero",
            ".trustPanel",
            ".trustCard",
            ".trustWide",
            ".trustTable",
            ".heroTrustItem",
            ".heroVisualShell",
            ".portalSide",
            ".portalFormCard",
            ".portalNote",
            "details.qa"
          ];

          const nodes = Array.from(document.querySelectorAll(selectors.join(",")));
          if (!nodes.length) return;

          nodes.forEach((node, idx) => {
            node.classList.add("reveal");
            node.style.setProperty("--reveal-delay", `${Math.min((idx % 6) * 55, 260)}ms`);
          });

          const io = new IntersectionObserver((entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              observer.unobserve(entry.target);
            }
          }, { threshold: 0.16, rootMargin: "0px 0px -8% 0px" });

          nodes.forEach((node) => io.observe(node));
        } catch (_) {}

      })();
    </script>
  </body>
</html>
