---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What do I get in the Free Audit?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "A structured audit summary with ranked findings, operating risks, and a 30/60/90 recovery outline in an executive-ready format.",
      },
    },
    {
      "@type": "Question",
      name: "When should I upgrade to Pro Audit?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "Upgrade when you need quantified impact, governance mapping, and an owner-ready execution plan.",
      },
    },
    {
      "@type": "Question",
      name: "Is OpsMind software or service?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "OpsMind is an operating cadence engagement that combines product surfaces with governance routines and outcome tracking.",
      },
    },
    {
      "@type": "Question",
      name: "Can EraIn work with messy data?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "Yes. We start from current systems (ERP, Excel, Tally, exports) and harden data quality as part of delivery.",
      },
    },
  ],
});
---

<BaseLayout title="Pricing • EraIn AI" description="Outcome-led pricing in INR and USD for auditability, decision governance, and ROI attribution.">
  <section class="pricingV2">
    <header class="pricingHero reveal">
      <div class="pricingEyebrow">Pricing</div>
      <h1 class="h1 pricingTitle">Simple pricing. Serious execution outcomes.</h1>
      <p class="lead pricingLead">
        Start with truth, upgrade only when measurable value is visible. EraIn pricing is designed for decision quality,
        governed execution, and provable ROI, not dashboard volume.
      </p>

      <div class="currencySwitchWrap" aria-label="Currency display control">
        <div class="currencyLabel">Display currency</div>
        <div class="currencySwitch" role="group" aria-label="Choose currency">
          <button type="button" class="currencyBtn active" data-currency-btn="INR" aria-pressed="true">INR</button>
          <button type="button" class="currencyBtn" data-currency-btn="USD" aria-pressed="false">USD</button>
        </div>
        <div class="currencyHint">Auto-selected by locale and always switchable. Billing can be INR or USD by region.</div>
      </div>

      <div class="heroMeta" role="list" aria-label="Pricing principles">
        <div class="metaCard" role="listitem">
          <div class="metaK">Commercial model</div>
          <div class="metaV">Outcomes, not AI hours</div>
        </div>
        <div class="metaCard" role="listitem">
          <div class="metaK">Engagement start</div>
          <div class="metaV">Free entry audit</div>
        </div>
        <div class="metaCard" role="listitem">
          <div class="metaK">Primary motion</div>
          <div class="metaV">21-day pilot cadence</div>
        </div>
      </div>
    </header>

    <section class="plans reveal" aria-label="Pricing plans">
      <article class="planCard">
        <div class="planHead">
          <div>
            <div class="planName">EraIn Audit AI</div>
            <div class="planMeta">Entry audit</div>
          </div>
          <div class="planPrice jsCurrencyValue" data-main-inr="₹0" data-main-usd="$0" data-alt-inr="No card required" data-alt-usd="No card required">
            <span class="moneyMain">₹0</span>
            <span class="moneyAlt">No card required</span>
          </div>
        </div>
        <ul class="planList">
          <li>Business health audit with ranked leakage map</li>
          <li>Auditability baseline and confidence lens</li>
          <li>30/60/90 action roadmap</li>
          <li>Executive-ready summary report</li>
        </ul>
        <a href="/request-assessment" class="btn btnPrimary" data-track="pricing_free_start">Start Free Audit</a>
      </article>

      <article class="planCard planFeatured" aria-label="Recommended plan">
        <div class="planRibbon">Recommended</div>
        <div class="planHead">
          <div>
            <div class="planName">EraIn Pro Audit</div>
            <div class="planMeta">Fixed-scope engagement</div>
          </div>
          <div class="planPrice jsCurrencyValue" data-main-inr="₹75,000" data-main-usd="$900" data-alt-inr="7-10 day delivery" data-alt-usd="7-10 day delivery">
            <span class="moneyMain">₹75,000</span>
            <span class="moneyAlt">7-10 day delivery</span>
          </div>
        </div>
        <ul class="planList">
          <li>Root-cause mapping for top value leaks</li>
          <li>Quantified impact and recovery potential</li>
          <li>Owner-mapped 90-day execution plan</li>
          <li>Leadership readout and rollout alignment</li>
        </ul>
        <a href="/contact" class="btn btnPrimary" data-track="pricing_pro_contact">Talk to EraIn</a>
      </article>

      <article class="planCard">
        <div class="planHead">
          <div>
            <div class="planName">EraIn OpsMind</div>
            <div class="planMeta">Monthly operating cadence</div>
          </div>
          <div class="planPrice jsCurrencyValue" data-main-inr="₹1,50,000+" data-main-usd="$1,800+" data-alt-inr="Per month" data-alt-usd="Per month">
            <span class="moneyMain">₹1,50,000+</span>
            <span class="moneyAlt">Per month</span>
          </div>
        </div>
        <ul class="planList">
          <li>Weekly decision briefs and anomaly watch</li>
          <li>Cadence governance and action discipline</li>
          <li>KPI movement tracking with attribution cues</li>
          <li>Execution coaching for owner teams</li>
        </ul>
        <a href="/contact" class="btn" data-track="pricing_opsmind_contact">Discuss OpsMind</a>
      </article>

      <article class="planCard">
        <div class="planHead">
          <div>
            <div class="planName">EraIn Impact AI</div>
            <div class="planMeta">Enterprise scale</div>
          </div>
          <div class="planPrice jsCurrencyValue" data-main-inr="Custom" data-main-usd="Custom" data-alt-inr="INR or USD billing" data-alt-usd="USD or INR billing">
            <span class="moneyMain">Custom</span>
            <span class="moneyAlt">INR or USD billing</span>
          </div>
        </div>
        <ul class="planList">
          <li>Multi-site governance architecture</li>
          <li>Role-scoped control paths and audit trails</li>
          <li>VPC/on-prem deployment options</li>
          <li>Procurement-ready trust package</li>
        </ul>
        <a href="/contact" class="btn" data-track="pricing_enterprise_contact">Talk Enterprise</a>
      </article>
    </section>

    <section class="compare reveal" aria-label="Commercial comparison">
      <div class="compareHead">
        <h2 class="h2">How leaders choose the right tier</h2>
        <p>Progress from clarity to repeatable execution. Upgrade only after evidence and governance are in place.</p>
      </div>

      <div class="compareGrid" role="table" aria-label="Pricing comparison table">
        <div class="compareRow compareRowHead" role="row">
          <div class="compareCell" role="columnheader">Dimension</div>
          <div class="compareCell" role="columnheader">Free Audit</div>
          <div class="compareCell" role="columnheader">Pro Audit</div>
          <div class="compareCell" role="columnheader">OpsMind / Impact</div>
        </div>
        <div class="compareRow" role="row">
          <div class="compareCell" role="cell">Primary objective</div>
          <div class="compareCell" role="cell">Visibility</div>
          <div class="compareCell" role="cell">Decision-ready plan</div>
          <div class="compareCell" role="cell">Execution at scale</div>
        </div>
        <div class="compareRow" role="row">
          <div class="compareCell" role="cell">Output artifact</div>
          <div class="compareCell" role="cell">Ranked findings</div>
          <div class="compareCell" role="cell">Quantified roadmap</div>
          <div class="compareCell" role="cell">Operating control loop</div>
        </div>
        <div class="compareRow" role="row">
          <div class="compareCell" role="cell">Decision governance</div>
          <div class="compareCell" role="cell">Baseline</div>
          <div class="compareCell" role="cell">Mapped owners + cadence</div>
          <div class="compareCell" role="cell">Enforced governance system</div>
        </div>
        <div class="compareRow" role="row">
          <div class="compareCell" role="cell">ROI attribution</div>
          <div class="compareCell" role="cell">Directional</div>
          <div class="compareCell" role="cell">Modeled recovery bands</div>
          <div class="compareCell" role="cell">Live attribution ledger</div>
        </div>
      </div>
    </section>

    <section class="faqBand reveal" aria-label="Pricing FAQ">
      <h2 class="h2">FAQ</h2>
      <details class="qa" open>
        <summary>What do I get in the Free Audit?</summary>
        <p>A structured audit summary, ranked risks, and a practical recovery outline for leadership review.</p>
      </details>
      <details class="qa">
        <summary>When should I upgrade to Pro Audit?</summary>
        <p>When you need quantified value, owner-path governance, and a deployment-ready plan.</p>
      </details>
      <details class="qa">
        <summary>Can EraIn work with existing messy systems?</summary>
        <p>Yes. Most engagements begin with mixed-quality exports and still produce governance-grade execution outputs.</p>
      </details>
      <details class="qa">
        <summary>Do you support INR and USD commercially?</summary>
        <p>Yes. Pricing is visible in INR and USD, and invoicing follows your contracting region.</p>
      </details>
    </section>

    <section class="pricingCta reveal" aria-label="Pricing CTA">
      <div>
        <div class="pricingEyebrow">Next step</div>
        <h2 class="h2">Start with the free audit and decide with proof.</h2>
      </div>
      <div class="ctaActions">
        <a class="btn btnPrimary" href="/request-assessment" data-track="pricing_footer_start">Start Free AI Audit</a>
        <a class="btn" href="/contact" data-track="pricing_footer_contact">Speak with EraIn</a>
      </div>
    </section>

    <script is:inline>
      (function () {
        const root = document.querySelector(".pricingV2");
        if (!root) return;

        const values = Array.from(root.querySelectorAll(".jsCurrencyValue"));
        const buttons = Array.from(root.querySelectorAll("[data-currency-btn]"));
        if (!values.length || !buttons.length) return;

        const normalize = (v) => String(v || "").trim().toUpperCase();
        const supported = (v) => v === "INR" || v === "USD";

        const detectDefault = () => {
          try {
            const byQuery = normalize(new URL(window.location.href).searchParams.get("currency"));
            if (supported(byQuery)) return { currency: byQuery, source: "query" };
          } catch (_) {}

          try {
            const byStorage = normalize(localStorage.getItem("erain_currency"));
            if (supported(byStorage)) return { currency: byStorage, source: "storage" };
          } catch (_) {}

          const locale = normalize((Intl.NumberFormat().resolvedOptions().locale || navigator.language || "").replace("_", "-"));
          const tz = normalize(Intl.DateTimeFormat().resolvedOptions().timeZone || "");
          const indiaLocale = /(^|-)IN($|-)/.test(locale);
          const indiaTimezone = tz.includes("KOLKATA") || tz.includes("CALCUTTA");
          return { currency: indiaLocale || indiaTimezone ? "INR" : "USD", source: "auto" };
        };

        const applyCurrency = (currency) => {
          for (const node of values) {
            const mainNode = node.querySelector(".moneyMain");
            const altNode = node.querySelector(".moneyAlt");
            const main = node.getAttribute(`data-main-${currency.toLowerCase()}`);
            const alt = node.getAttribute(`data-alt-${currency.toLowerCase()}`);
            if (mainNode && main) mainNode.textContent = main;
            if (altNode && alt) altNode.textContent = alt;
          }

          for (const button of buttons) {
            const on = normalize(button.getAttribute("data-currency-btn")) === currency;
            button.classList.toggle("active", on);
            button.setAttribute("aria-pressed", on ? "true" : "false");
          }

          try {
            localStorage.setItem("erain_currency", currency);
          } catch (_) {}
        };

        const detected = detectDefault();
        applyCurrency(detected.currency);

        for (const button of buttons) {
          button.addEventListener("click", () => {
            const currency = normalize(button.getAttribute("data-currency-btn"));
            if (!supported(currency)) return;
            applyCurrency(currency);
          });
        }
      })();
    </script>

    <script type="application/ld+json" is:inline>{faqJsonLd}</script>
  </section>

  <style>
    .pricingV2 {
      max-width: 1340px;
      margin: 0 auto;
      display: grid;
      gap: 24px;
      padding-bottom: 20px;
    }

    .pricingHero,
    .plans,
    .compare,
    .faqBand,
    .pricingCta {
      border: 1px solid rgba(15, 23, 42, 0.11);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 0 18px 44px rgba(2, 10, 32, 0.08);
      padding: clamp(18px, 3vw, 30px);
    }

    .pricingEyebrow {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(15, 23, 42, 0.16);
      border-radius: 999px;
      padding: 8px 14px;
      color: rgba(15, 23, 42, 0.72);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.72);
    }

    .pricingTitle {
      margin-top: 14px;
      max-width: 20ch;
      font-size: clamp(40px, 7vw, 78px);
      line-height: 0.96;
      letter-spacing: -0.05em;
      font-weight: 860;
    }

    .pricingLead {
      margin-top: 14px;
      max-width: 70ch;
      font-size: clamp(17px, 2vw, 22px);
      line-height: 1.58;
      color: rgba(15, 23, 42, 0.7);
    }

    .currencySwitchWrap {
      margin-top: 16px;
      display: grid;
      gap: 8px;
      max-width: 520px;
    }

    .currencyLabel {
      font-size: 11px;
      font-weight: 840;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.56);
    }

    .currencySwitch {
      display: inline-grid;
      grid-template-columns: repeat(2, minmax(82px, 1fr));
      gap: 6px;
      border: 1px solid rgba(15, 23, 42, 0.14);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.84);
      padding: 6px;
      width: fit-content;
    }

    .currencyBtn {
      appearance: none;
      border: 1px solid transparent;
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 800;
      color: rgba(15, 23, 42, 0.68);
      background: transparent;
      cursor: pointer;
      transition: all 150ms ease;
    }

    .currencyBtn.active {
      color: #fff;
      background: linear-gradient(135deg, #245adf, #0a8cb8);
      border-color: rgba(255, 255, 255, 0.24);
      box-shadow: 0 10px 22px rgba(36, 90, 223, 0.24);
    }

    .currencyHint {
      font-size: 12px;
      color: rgba(15, 23, 42, 0.62);
      line-height: 1.55;
    }

    .heroMeta {
      margin-top: 16px;
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }

    .metaCard {
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.7);
      padding: 12px 14px;
    }

    .metaK {
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 840;
      color: rgba(15, 23, 42, 0.56);
    }

    .metaV {
      margin-top: 5px;
      color: rgba(15, 23, 42, 0.9);
      font-size: 17px;
      line-height: 1.28;
      letter-spacing: -0.02em;
      font-weight: 760;
    }

    .plans {
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr;
    }

    .planCard {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 20px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.82);
      display: grid;
      gap: 12px;
      align-content: start;
    }

    .planFeatured {
      border-color: rgba(36, 90, 223, 0.28);
      background:
        radial-gradient(680px 220px at 0% -10%, rgba(36, 90, 223, 0.08), transparent 70%),
        rgba(255, 255, 255, 0.88);
      box-shadow: 0 20px 48px rgba(36, 90, 223, 0.12);
      position: relative;
    }

    .planRibbon {
      display: inline-flex;
      width: fit-content;
      border: 1px solid rgba(36, 90, 223, 0.22);
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 10px;
      font-weight: 850;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #1f4dc4;
      background: rgba(36, 90, 223, 0.1);
    }

    .planHead {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: flex-start;
    }

    .planName {
      font-size: 24px;
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-weight: 800;
      color: rgba(15, 23, 42, 0.93);
    }

    .planMeta {
      margin-top: 4px;
      font-size: 13px;
      color: rgba(15, 23, 42, 0.62);
    }

    .planPrice {
      text-align: right;
      display: grid;
      gap: 3px;
      min-width: 120px;
    }

    .moneyMain {
      font-size: clamp(30px, 4.4vw, 46px);
      line-height: 0.95;
      letter-spacing: -0.035em;
      font-weight: 860;
      color: rgba(15, 23, 42, 0.95);
    }

    .moneyAlt {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.56);
      font-weight: 760;
    }

    .planList {
      margin: 0;
      padding-left: 18px;
      color: rgba(15, 23, 42, 0.78);
      font-size: 14px;
      line-height: 1.58;
      display: grid;
      gap: 6px;
    }

    .compareHead p {
      margin: 8px 0 0;
      color: rgba(15, 23, 42, 0.68);
      line-height: 1.6;
      font-size: 15px;
    }

    .compareGrid {
      margin-top: 12px;
      display: grid;
      gap: 8px;
    }

    .compareRow {
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.74);
      padding: 10px;
    }

    .compareRowHead {
      background: rgba(15, 23, 42, 0.05);
    }

    .compareCell {
      color: rgba(15, 23, 42, 0.75);
      font-size: 13px;
      line-height: 1.5;
    }

    .compareRowHead .compareCell {
      color: rgba(15, 23, 42, 0.9);
      font-size: 11px;
      font-weight: 840;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .faqBand {
      display: grid;
      gap: 10px;
    }

    .qa {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.72);
      padding: 12px 14px;
    }

    .qa summary {
      cursor: pointer;
      font-weight: 760;
      color: rgba(15, 23, 42, 0.9);
      list-style: none;
    }

    .qa summary::-webkit-details-marker {
      display: none;
    }

    .qa p {
      margin: 8px 0 0;
      color: rgba(15, 23, 42, 0.68);
      font-size: 14px;
      line-height: 1.58;
    }

    .pricingCta {
      display: grid;
      gap: 14px;
      align-items: center;
    }

    .ctaActions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    @media (min-width: 900px) {
      .heroMeta {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .plans {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .compareRow {
        grid-template-columns: 1.1fr 0.9fr 0.9fr 1.1fr;
        align-items: start;
      }

      .pricingCta {
        grid-template-columns: minmax(0, 1fr) auto;
      }
    }

    @media (min-width: 1240px) {
      .plans {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media (max-width: 768px) {
      .pricingHero,
      .plans,
      .compare,
      .faqBand,
      .pricingCta {
        border-radius: 22px;
        padding: 16px;
      }

      .pricingTitle {
        max-width: 12ch;
      }

      .planHead {
        display: grid;
        gap: 8px;
      }

      .planPrice {
        text-align: left;
      }

      .ctaActions .btn,
      .planCard .btn {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
