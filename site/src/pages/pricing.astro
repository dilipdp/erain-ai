---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What do I get in the Free Audit?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "A structured audit summary with key findings, top risks, opportunities, and a 30/60/90-day action roadmap, plus an executive-ready PDF report.",
      },
    },
    {
      "@type": "Question",
      name: "When should I upgrade to Pro Audit?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "Upgrade when you want quantified impact estimates, root-cause analysis, and an executive-ready 90-day plan before committing internal resources.",
      },
    },
    {
      "@type": "Question",
      name: "Is OpsMind a software product or a service?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "OpsMind is a productized engagement: dashboards and alerts where needed, plus an operating cadence that drives real execution outcomes.",
      },
    },
    {
      "@type": "Question",
      name: "Can you work with Excel/Tally and messy data?",
      acceptedAnswer: {
        "@type": "Answer",
        text:
          "Yes. We start from whatever exists today (Excel, Tally, ERP, and messy data) and improve data quality as part of the execution plan.",
      },
    },
  ],
});
---

<BaseLayout title="Pricing • EraIn AI" description="Outcome-driven pricing that moves from clarity → confidence → disciplined execution → measurable impact. Start with EraIn Audit AI™.">
  <section class="pricing">
    <div class="hero">
      <div class="heroGlow" aria-hidden="true"></div>

      <div class="badgeRow">
        <span class="badge badgeSoft">Truth-first</span>
        <span class="badge badgeSoft">Proof-based</span>
        <span class="badge badgeSoft">Measurable ROI</span>
        <span class="badge badgeSoft">Month-to-month</span>
      </div>

      <h1 class="h1">Simple pricing. Measurable business impact.</h1>
      <p class="lead">
        Start with an audit-first profitability assessment. Upgrade only when value is clear, quantified, and execution-ready.
        EraIn is built for leaders who want verified reality, better decisions, and measurable delivery — not vanity dashboards.
      </p>

      <div class="heroSub">
        <div class="heroStat">
          <div class="heroStatK">What you get</div>
          <div class="heroStatV">Clarity → Plan → Execution</div>
        </div>
        <div class="heroStat">
          <div class="heroStatK">How we price</div>
          <div class="heroStatV">Outcomes, not AI hours</div>
        </div>
        <div class="heroStat">
          <div class="heroStatK">How we start</div>
          <div class="heroStatV">Free entry audit (no card)</div>
        </div>
      </div>
    </div>

    <section class="pricingEvidence" aria-label="Pricing value evidence">
      <div class="pricingEvidenceHead">
        <div class="pricingEvidenceKicker">Value Evidence</div>
        <h2 class="h2 pricingEvidenceTitle">Pricing that is designed to fund itself.</h2>
        <p class="pricingEvidenceLead">
          The model is built around cost leakage recovery and execution discipline. Typical improvement windows vary by context,
          but the structure is consistent: audit first, quantify second, scale only when value is provable.
        </p>
      </div>

      <div class="pricingEvidenceGrid" role="list" aria-label="Value evidence modules">
        <article class="pricingEvidenceCard" role="listitem">
          <div class="pricingEvidenceLabel">Payback Band</div>
          <div class="pricingEvidenceValue">60-120 days</div>
          <div class="pricingEvidenceText">Most Pro Audit plans are structured to recover more than engagement cost inside first execution cycle.</div>
        </article>
        <article class="pricingEvidenceCard" role="listitem">
          <div class="pricingEvidenceLabel">Governance Delta</div>
          <div class="pricingEvidenceValue">2-3x faster decisions</div>
          <div class="pricingEvidenceText">Owner mapping and approval pathways reduce cycle-time lost in cross-functional escalations.</div>
        </article>
        <article class="pricingEvidenceCard" role="listitem">
          <div class="pricingEvidenceLabel">Attribution Coverage</div>
          <div class="pricingEvidenceValue">Action-to-Outcome Ledger</div>
          <div class="pricingEvidenceText">Impact tracking links execution moves to financial and operational outcomes leadership can verify.</div>
        </article>
      </div>
    </section>

    <div class="pricingGrid">
      <!-- Free -->
      <article class="tier">
        <div class="tierTop">
          <div>
            <div class="kicker">EraIn Audit AI™</div>
            <div class="tierMeta">Free entry audit</div>
          </div>
          <div class="price">
            <div class="priceValue">₹0</div>
            <div class="priceNote">No credit card</div>
          </div>
        </div>

        <ul class="tierList">
          <li>AI-powered business health audit</li>
          <li>Hidden cost & execution leak detection</li>
          <li>Ranked findings by urgency & expected impact</li>
          <li>30 / 60 / 90-day recovery roadmap</li>
          <li>Executive-ready PDF report + next steps</li>
        </ul>

        <div class="tierCta">
          <a href="/request-assessment" class="btn btnPrimary" data-track="pricing_tier_free_start_audit">Start Free AI Audit</a>
          <div class="tierHint">Fast intake. Private. High-signal questions only.</div>
        </div>
      </article>

      <!-- Pro Audit -->
      <article class="tier tierPro" aria-label="Recommended">
        <div class="tierRibbon">Recommended</div>

        <div class="tierTop">
          <div>
            <div class="kicker">EraIn Pro Audit™</div>
            <div class="tierMeta">One-time engagement</div>
          </div>
          <div class="price">
            <div class="priceValue">₹75,000</div>
            <div class="priceNote">7–10 days delivery</div>
          </div>
        </div>

        <ul class="tierList">
          <li><strong>Deep-dive analysis</strong> of your top operational leaks</li>
          <li><strong>Quantified impact</strong> (₹ loss / recovery estimates)</li>
          <li><strong>Root-cause mapping</strong> for the top 3 issues</li>
          <li><strong>90-day execution plan</strong> (owners, cadence, checkpoints)</li>
          <li><strong>CXO-ready report</strong> + deliverables you can execute</li>
          <li><strong>1-hour alignment call</strong> to confirm rollout and owners</li>
        </ul>

        <div class="tierCta">
          <a href="/contact" class="btn btnPrimary" data-track="pricing_tier_pro_talk">Talk to Us</a>
          <div class="tierHint">If you already did Free Audit, include your Request ID.</div>
        </div>
      </article>

      <!-- OpsMind -->
      <article class="tier">
        <div class="tierTop">
          <div>
            <div class="kicker">EraIn OpsMind™</div>
            <div class="tierMeta">Monthly operating cadence</div>
          </div>
          <div class="price">
            <div class="priceValue">₹1,50,000+</div>
            <div class="priceNote">per month</div>
          </div>
        </div>

        <ul class="tierList">
          <li>KPI automation & monitoring</li>
          <li>Weekly insights & anomaly alerts</li>
          <li>Weekly decision brief for ops & leadership</li>
          <li>Decision Engine™ support for prioritization</li>
          <li>Agentic workflows for repeat execution</li>
          <li>Continuous improvement tracking</li>
        </ul>

        <div class="tierCta">
          <a href="/contact" class="btn" data-track="pricing_tier_opsmind_talk">Talk About OpsMind</a>
          <div class="tierHint">Typically justified within 60–90 days through recovered value.</div>
        </div>
      </article>

      <!-- Impact AI -->
      <article class="tier">
        <div class="tierTop">
          <div>
            <div class="kicker">EraIn Impact AI™</div>
            <div class="tierMeta">Enterprise / Scale</div>
          </div>
          <div class="price">
            <div class="priceValue">Custom</div>
            <div class="priceNote">VPC / on-prem</div>
          </div>
        </div>

        <ul class="tierList">
          <li><strong>Designed for multi-site / multi-team enterprises</strong></li>
          <li>Outcome tracking tied to actions & decisions</li>
          <li>Financial impact attribution (ROI proof)</li>
          <li>Executive visibility across functions</li>
          <li>Long-term intelligence memory for the organization</li>
          <li>Decision Engine™ integration for scenario modeling</li>
          <li>Audit trails + compliance-ready governance</li>
        </ul>

        <div class="tierCta">
          <a href="/contact" class="btn" data-track="pricing_tier_impact_talk">Talk to Us</a>
          <div class="tierHint">We start from whatever exists today: Excel, Tally, ERP, messy data.</div>
        </div>
      </article>
    </div>

    <div class="trustStrip" role="note" aria-label="Trust and privacy note">
      <div class="trustItem">
        <div class="trustTitle">Privacy-first</div>
        <div class="trustText">Your data stays yours. We can start from Excel/Tally without invasive access.</div>
      </div>
      <div class="trustItem">
        <div class="trustTitle">Proof over promises</div>
        <div class="trustText">We quantify impact and map root causes before asking you to upgrade.</div>
      </div>
      <div class="trustItem">
        <div class="trustTitle">Clear terms</div>
        <div class="trustText">OpsMind stays month-to-month. Enterprise rollouts are scoped, priced, and governed explicitly.</div>
      </div>
    </div>

    <div class="after">
      <div class="afterCard">
        <h2 class="h2">How pricing works</h2>
        <p class="lead leadSm">
          We start with truth, quantify impact, and only then design execution. You upgrade only when ROI is obvious and ownership is clear.
        </p>
        <div class="steps">
          <div class="step"><span class="stepDot"></span><div><strong>Free Audit</strong><div class="muted">fast clarity + ranked 30/60/90 roadmap</div></div></div>
          <div class="step"><span class="stepDot"></span><div><strong>Pro Audit</strong><div class="muted">quantified impact + execution plan + alignment call</div></div></div>
          <div class="step"><span class="stepDot"></span><div><strong>OpsMind</strong><div class="muted">monthly operating cadence + agentic workflows</div></div></div>
          <div class="step"><span class="stepDot"></span><div><strong>Impact AI</strong><div class="muted">enterprise rollout + ROI proof + governance</div></div></div>
        </div>

        <div class="actions">
          <a href="/request-assessment" class="btn btnPrimary" data-track="pricing_after_start_audit">Start Free Audit</a>
          <a href="/contact" class="btn" data-track="pricing_after_talk">Talk to Us</a>
        </div>

        <p class="footnote">
          Prices shown are before GST. Enterprise pricing varies by plants/sites, integrations (ERP/Tally/Excel),
          and deployment (cloud/VPC/on-prem).
        </p>
      </div>

      <div class="afterCard">
        <h2 class="h2">FAQ</h2>
        <div class="faqHint">Short answers. If you want depth, ask — we’ll share the exact execution approach.</div>

        <details class="qa" open>
          <summary>What do I get in the Free Audit?</summary>
          <p>
            A structured audit summary with key findings, top risks, opportunities, and a 30/60/90-day action roadmap.
          </p>
        </details>

        <details class="qa">
          <summary>When should I upgrade to Pro Audit?</summary>
          <p>
            Upgrade when you want quantified impact estimates, root-cause analysis, and an executive-ready plan before committing resources.
          </p>
        </details>

        <details class="qa">
          <summary>Is OpsMind a software product or a service?</summary>
          <p>
            OpsMind is a productized engagement: dashboards/alerts where needed, plus an operating cadence that drives real execution outcomes.
          </p>
        </details>

        <details class="qa">
          <summary>Can you work with Excel/Tally and messy data?</summary>
          <p>
            Yes. We start from whatever exists today and improve data quality as part of the execution plan.
          </p>
        </details>
      </div>
    </div>

    <div class="closing">
      <div class="closingCard">
        <div>
          <div class="kicker">Principle</div>
          <h2 class="h2">We don’t price AI. We price outcomes.</h2>
          <p class="lead leadSm">Every engagement is designed to fund itself through recovered value.</p>
        </div>
        <a href="/request-assessment" class="btn btnPrimary" data-track="pricing_closing_start_audit">Start Free AI Audit</a>
      </div>
    </div>

    <script type="application/ld+json" is:inline>{faqJsonLd}</script>

    <style>
  .pricing {
    /* Wider container so 4 tiers feel premium (less cramped) */
    max-width: 1480px;
    margin: 0 auto;
    padding: 76px var(--gutter) 0;
  }

  @media (min-width: 1220px) {
    .pricing {
      padding-left: 28px;
      padding-right: 28px;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    max-width: 96ch;
    margin: 0 auto 34px;
    text-align: center;
  }

  .heroGlow {
    position: absolute;
    inset: -140px -60px auto;
    height: 300px;
    pointer-events: none;
    background:
      radial-gradient(700px 240px at 50% 30%, rgba(37, 99, 235, 0.18), transparent 65%),
      radial-gradient(620px 260px at 18% 20%, rgba(15, 23, 42, 0.10), transparent 70%),
      radial-gradient(560px 240px at 84% 10%, rgba(2, 6, 23, 0.06), transparent 70%);
    filter: blur(2px);
    opacity: 0.95;
  }

  .hero .badgeRow {
    justify-content: center;
    margin-bottom: 14px;
  }

  .hero .lead {
    max-width: 80ch;
    margin-left: auto;
    margin-right: auto;
  }

  .heroSub {
    margin: 18px auto 0;
    max-width: 92ch;
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
    justify-items: center;
  }

  @media (min-width: 780px) {
    .heroSub { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .heroStat {
    width: 100%;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 18px;
    background: rgba(16, 24, 40, 0.03);
    padding: 12px 14px;
    text-align: left;
  }

  .heroStatK {
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(17, 24, 39, 0.55);
  }

  .heroStatV {
    margin-top: 6px;
    font-weight: 950;
    letter-spacing: -0.02em;
    color: rgba(2, 6, 23, 0.88);
  }

  .leadSm {
    font-size: 16px;
    line-height: 1.85;
  }

  .pricingEvidence {
    max-width: 1320px;
    margin: 0 auto 18px;
    border: 1px solid rgba(11, 31, 66, 0.12);
    border-radius: 26px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.93) 0%,
        rgba(245, 250, 255, 0.86) 60%,
        rgba(240, 247, 255, 0.82) 100%
      );
    box-shadow:
      0 1px 2px rgba(0,0,0,0.04),
      0 22px 62px rgba(2, 10, 32, 0.14);
    padding: 18px;
  }

  .pricingEvidenceHead {
    max-width: 90ch;
  }

  .pricingEvidenceKicker {
    display: inline-flex;
    border: 1px solid rgba(11, 31, 66, 0.14);
    border-radius: 999px;
    background: rgba(16, 24, 40, 0.04);
    color: rgba(7, 20, 48, 0.86);
    padding: 7px 11px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pricingEvidenceTitle {
    margin-top: 10px;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .pricingEvidenceLead {
    margin: 10px 0 0;
    color: rgba(17, 24, 39, 0.7);
    line-height: 1.72;
    font-size: 15px;
  }

  .pricingEvidenceGrid {
    margin-top: 14px;
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
  }

  .pricingEvidenceCard {
    border: 1px solid rgba(11, 31, 66, 0.14);
    border-radius: 18px;
    background:
      linear-gradient(145deg, rgba(7, 24, 56, 0.96), rgba(9, 39, 86, 0.92) 56%, rgba(8, 27, 62, 0.94));
    box-shadow: 0 18px 40px rgba(2, 10, 32, 0.18);
    padding: 12px 13px;
    color: #eaf5ff;
  }

  .pricingEvidenceLabel {
    color: rgba(175, 222, 255, 0.94);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pricingEvidenceValue {
    margin-top: 6px;
    color: rgba(241, 249, 255, 0.98);
    font-size: 25px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 840;
  }

  .pricingEvidenceText {
    margin-top: 6px;
    color: rgba(190, 216, 241, 0.9);
    font-size: 13px;
    line-height: 1.58;
  }

  @media (min-width: 980px) {
    .pricingEvidenceGrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Grid */
  .pricingGrid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
    align-items: stretch;
    max-width: 1480px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 900px) {
    .pricingGrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1220px) {
    .pricingGrid {
      grid-template-columns: repeat(4, minmax(280px, 1fr));
      gap: 22px;
    }
  }

  .trustStrip {
    margin-top: 18px;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 980px) {
    .trustStrip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .trustItem {
    border: 1px solid rgba(17, 24, 39, 0.10);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.90) 0%, rgba(255, 255, 255, 0.72) 100%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      0 1px 2px rgba(0,0,0,0.04),
      0 14px 44px rgba(2, 6, 23, 0.08);
    padding: 16px 16px;
  }

  .trustTitle {
    font-weight: 950;
    letter-spacing: -0.01em;
    color: rgba(2, 6, 23, 0.88);
  }

  .trustText {
    margin-top: 6px;
    color: rgba(17, 24, 39, 0.68);
    line-height: 1.65;
    font-size: 13px;
  }

  /* Tier cards */
  .tier {
    position: relative;
    border-radius: 28px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;

    /* premium glass */
    border: 1px solid rgba(17, 24, 39, 0.10);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.72) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow:
      0 1px 2px rgba(0,0,0,0.05),
      0 18px 50px rgba(2, 6, 23, 0.10);

    transform: translateZ(0);
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .tier::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 28px;
    pointer-events: none;
    background:
      radial-gradient(900px 260px at 50% 0%, rgba(37, 99, 235, 0.10), transparent 60%),
      radial-gradient(720px 260px at 0% 35%, rgba(15, 23, 42, 0.06), transparent 62%);
    opacity: 0.9;
  }

  .tier > * { position: relative; }

  .tier:hover {
    transform: translateY(-4px);
    border-color: rgba(17, 24, 39, 0.16);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.78) 100%);
    box-shadow:
      0 1px 2px rgba(0,0,0,0.05),
      0 24px 70px rgba(2, 6, 23, 0.12);
  }

  .tierTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(17, 24, 39, 0.08);
    flex-wrap: wrap; /* prevent header overlap */
    align-content: start;
    min-height: 0;
    padding-top: 2px;
  }

  .kicker {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(17, 24, 39, 0.62);
  }

  .tierMeta {
    margin-top: 6px;
    color: rgba(17, 24, 39, 0.62);
    font-size: 13px;
    font-weight: 650;
  }

  .price {
    text-align: right;
    min-width: 0;
    margin-left: auto;
    display: grid;
    justify-items: end;
    gap: 2px;
  }

  .priceValue {
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: 950;
    letter-spacing: -0.03em;
    color: var(--primary);
    line-height: 1.05;
    white-space: nowrap;
  }

  .priceNote {
    margin-top: 6px;
    font-size: 12px;
    color: rgba(17, 24, 39, 0.56);
    font-weight: 700;
  }

  .tierList {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: rgba(17, 24, 39, 0.76);
    line-height: 1.72;
    flex: 1;
    display: grid;
    gap: 12px;
  }

  .tierList li {
    position: relative;
    padding-left: 26px;
  }

  .tierList li::before {
    content: "✓";
    width: 16px;
    height: 16px;
    border-radius: 999px;
    position: absolute;
    left: 0;
    top: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 900;
    color: rgba(29, 78, 216, 0.98);
    background: rgba(37, 99, 235, 0.10);
    border: 1px solid rgba(37, 99, 235, 0.18);
  }

  .tierCta {
    margin-top: 16px;
    display: grid;
    gap: 10px;
  }

  .tierHint {
    font-size: 12px;
    color: rgba(17, 24, 39, 0.58);
    line-height: 1.55;
  }

  /* Recommended tier */
  .tierPro {
    position: relative;

    /* Reserve space so the ribbon never overlaps the header */
    padding-top: 88px;

    border-color: rgba(37, 99, 235, 0.26);
    background:
      linear-gradient(180deg, rgba(37, 99, 235, 0.12) 0%, rgba(255, 255, 255, 0.82) 70%);
    box-shadow:
      0 1px 2px rgba(0,0,0,0.05),
      0 30px 90px rgba(37, 99, 235, 0.16);
  }

  .tierPro:hover {
    border-color: rgba(37, 99, 235, 0.34);
    box-shadow:
      0 1px 2px rgba(0,0,0,0.05),
      0 38px 120px rgba(37, 99, 235, 0.20);
  }

  /* Pin the pill to the top of ONLY the Pro card */
  .pricing .tierPro > .tierRibbon {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 6;

    /* Ensure it never pushes content (no in-flow spacing) */
    margin: 0;

    width: calc(100% - 44px);
    max-width: 440px;
    height: 42px;
    padding: 0 22px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 999px;

    font-size: 12px;
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;

    color: rgba(29, 78, 216, 0.95);

    background: rgba(255, 255, 255, 0.96);
