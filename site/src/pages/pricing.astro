---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Can we contract in INR and USD?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. EraIn supports INR and USD billing. Currency display is switchable on this page for planning conversations.",
      },
    },
    {
      "@type": "Question",
      name: "What is the fastest path to measurable value?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Most teams start with EraIn Pro Audit to get quantified leakage recovery, governance mapping, and an owner-ready execution plan in 7 to 10 days.",
      },
    },
    {
      "@type": "Question",
      name: "How should enterprise buyers evaluate plans?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Choose by operating complexity, governance burden, and procurement requirements. Start with proof and scale after measurable outcomes are validated.",
      },
    },
  ],
});
---

<BaseLayout
  title="Pricing • EraIn AI"
  description="Outcome-first pricing for auditability, decision governance, and measurable ROI attribution."
  pageClass="pricingPageWrap"
>
  <section class="pricingPage" aria-label="EraIn pricing">
    <header class="hero panel reveal" aria-label="Pricing hero">
      <div class="heroLeft">
        <div class="eyebrow">EraIn Pricing System</div>
        <h1 class="heroTitle">
          Command reality.<br />
          <span class="displaySerif">Price by outcomes.</span>
        </h1>
        <p class="heroLead">
          EraIn pricing is built for operators, not vanity dashboards. You buy measurable execution progress: auditability,
          governance, and attributed business value.
        </p>

        <div class="heroStats" role="list" aria-label="Pricing highlights">
          <article class="stat" role="listitem">
            <div class="k">P50 time-to-value</div>
            <div class="v">18 days target</div>
          </article>
          <article class="stat" role="listitem">
            <div class="k">Primary paid motion</div>
            <div class="v">21-day pilot</div>
          </article>
          <article class="stat" role="listitem">
            <div class="k">Expansion rule</div>
            <div class="v">Proof before scale</div>
          </article>
        </div>
      </div>

      <aside class="heroRight" aria-label="Pricing controls">
        <div class="heroControl">
          <div class="controlRow">
            <span>Currency</span>
            <div class="switch" role="group" aria-label="Currency switch">
              <button type="button" class="switchBtn active" data-currency-btn="INR" aria-pressed="true">INR</button>
              <button type="button" class="switchBtn" data-currency-btn="USD" aria-pressed="false">USD</button>
            </div>
          </div>
          <div class="controlRow">
            <span>Billing view</span>
            <div class="switch" role="group" aria-label="Billing switch">
              <button type="button" class="switchBtn active" data-billing-btn="MONTHLY" aria-pressed="true">Monthly</button>
              <button type="button" class="switchBtn" data-billing-btn="ANNUAL" aria-pressed="false">Annual</button>
            </div>
          </div>
          <p>Annual view applies to recurring plans. One-time pilot plans remain fixed.</p>
        </div>

        <div class="recommended">
          <div class="k">Recommended Start</div>
          <h2>EraIn Pro Audit</h2>
          <div class="price jsPlanPrice" data-price-type="one-time" data-inr="₹75,000" data-usd="$900" data-sub-inr="7-10 day delivery" data-sub-usd="7-10 day delivery">
            <span class="moneyMain">₹75,000</span>
            <span class="moneyAlt">7-10 day delivery</span>
          </div>
          <p>Quantified leakage recovery + owner-mapped execution plan with governance boundaries.</p>
          <a href="/contact" class="btn btnPrimary" data-track="pricing_hero_pro">Talk to EraIn</a>
        </div>
      </aside>
    </header>

    <section class="plans panel reveal" aria-label="Plans">
      <div class="sectionHead">
        <div class="eyebrow">Plans</div>
        <h2 class="h2">Choose the right operating motion</h2>
      </div>

      <div class="planGrid">
        <article class="planCard">
          <div class="tier">Entry</div>
          <div class="top">
            <div>
              <h3>EraIn Audit AI</h3>
              <p>Audit baseline</p>
            </div>
            <div class="price jsPlanPrice" data-price-type="one-time" data-inr="₹0" data-usd="$0" data-sub-inr="No card required" data-sub-usd="No card required">
              <span class="moneyMain">₹0</span>
              <span class="moneyAlt">No card required</span>
            </div>
          </div>
          <ul>
            <li>Leakage map in under 60 seconds</li>
            <li>Auditability confidence baseline</li>
            <li>30/60/90 first-action outline</li>
          </ul>
          <a href="/request-assessment" class="btn btnPrimary" data-track="pricing_plan_free">Start Free Audit</a>
        </article>

        <article class="planCard featured">
          <div class="tier">Recommended</div>
          <div class="top">
            <div>
              <h3>EraIn Pro Audit</h3>
              <p>Fixed-scope pilot</p>
            </div>
            <div class="price jsPlanPrice" data-price-type="one-time" data-inr="₹75,000" data-usd="$900" data-sub-inr="7-10 day delivery" data-sub-usd="7-10 day delivery">
              <span class="moneyMain">₹75,000</span>
              <span class="moneyAlt">7-10 day delivery</span>
            </div>
          </div>
          <ul>
            <li>Quantified value recovery model</li>
            <li>Owner-mapped decision governance</li>
            <li>Board-ready execution readout</li>
          </ul>
          <a href="/contact" class="btn btnPrimary" data-track="pricing_plan_pro">Talk to EraIn</a>
        </article>

        <article class="planCard">
          <div class="tier">Scale</div>
          <div class="top">
            <div>
              <h3>EraIn OpsMind</h3>
              <p>Monthly operating cadence</p>
            </div>
            <div class="price jsPlanPrice" data-price-type="recurring" data-month-inr="₹1,50,000" data-month-usd="$1,800" data-year-inr="₹16,20,000" data-year-usd="$19,440" data-sub-monthly="per month" data-sub-annual="annual contract view">
              <span class="moneyMain">₹1,50,000</span>
              <span class="moneyAlt">per month</span>
            </div>
          </div>
          <ul>
            <li>Weekly decision cadence and anomaly control</li>
            <li>KPI-linked action closure discipline</li>
            <li>Leadership execution coaching</li>
          </ul>
          <a href="/contact" class="btn" data-track="pricing_plan_opsmind">Discuss OpsMind</a>
        </article>

        <article class="planCard">
          <div class="tier">Enterprise</div>
          <div class="top">
            <div>
              <h3>EraIn Impact AI</h3>
              <p>Enterprise control layer</p>
            </div>
            <div class="price jsPlanPrice" data-price-type="enterprise" data-inr="Custom" data-usd="Custom" data-sub-inr="INR or USD billing" data-sub-usd="USD or INR billing">
              <span class="moneyMain">Custom</span>
              <span class="moneyAlt">INR or USD billing</span>
            </div>
          </div>
          <ul>
            <li>Multi-site governance architecture</li>
            <li>Role-scoped control and audit trails</li>
            <li>Procurement-ready trust pack</li>
          </ul>
          <a href="/contact" class="btn" data-track="pricing_plan_enterprise">Talk Enterprise</a>
        </article>
      </div>
    </section>

    <section class="decision panel reveal" aria-label="Decision lens">
      <div class="sectionHead">
        <div class="eyebrow">Decision Lens</div>
        <h2 class="h2">Role-based commercial guidance</h2>
      </div>

      <div class="lensGrid">
        <div class="buyerTabs" role="tablist" aria-label="Buyer role selector">
          <button type="button" class="buyerTab active" data-buyer="cfo" role="tab" aria-selected="true">CFO</button>
          <button type="button" class="buyerTab" data-buyer="coo" role="tab" aria-selected="false">COO</button>
          <button type="button" class="buyerTab" data-buyer="cto" role="tab" aria-selected="false">CTO</button>
          <button type="button" class="buyerTab" data-buyer="procurement" role="tab" aria-selected="false">Procurement</button>
        </div>

        <article class="buyerResult" id="buyerResult" aria-live="polite"></article>
      </div>
    </section>

    <section class="preview panel reveal" aria-label="Value preview">
      <div class="sectionHead">
        <div class="eyebrow">Value Preview</div>
        <h2 class="h2">Estimate your recoverable window</h2>
      </div>

      <div class="previewGrid">
        <div class="sliderWrap">
          <label for="leakSlider">Annual value leakage estimate</label>
          <input id="leakSlider" type="range" min="10" max="500" step="5" value="120" />
          <p><span id="leakOut">₹1,20,00,000</span> estimated annual leakage profile</p>
        </div>

        <article class="previewCard">
          <div class="k">Indicative recommendation</div>
          <h3 id="previewPlan">EraIn Pro Audit</h3>
          <p id="previewReason">Strong candidate for quantified pilot before recurring cadence.</p>
          <div class="previewMetrics" role="list">
            <div class="m" role="listitem"><span>90-day recovery window</span><strong id="previewRecovery">₹26,40,000</strong></div>
            <div class="m" role="listitem"><span>Expected payback</span><strong id="previewPayback">9-12 weeks</strong></div>
          </div>
          <a href="/contact" class="btn btnPrimary" data-track="pricing_preview_cta">Request tailored recommendation</a>
        </article>
      </div>
    </section>

    <section class="proof panel reveal" aria-label="Proof and trust">
      <div class="sectionHead">
        <div class="eyebrow">Proof + Trust</div>
        <h2 class="h2">Commercial confidence for buyers and procurement</h2>
      </div>

      <div class="proofGrid">
        <article class="proofCard">
          <div class="k">Manufacturing</div>
          <h3>2.7x to 3.3x recovery trajectory</h3>
          <p>12-week execution window with owner-mapped controls and value attribution cadence.</p>
        </article>
        <article class="proofCard">
          <div class="k">Logistics</div>
          <h3>22% faster decision closure</h3>
          <p>Approval path bottlenecks reduced through role-scoped governance thresholds.</p>
        </article>
        <article class="proofCard">
          <div class="k">Services</div>
          <h3>94% evidence confidence</h3>
          <p>Recommendation handoff linked to traceable evidence and accountable owners.</p>
        </article>
      </div>

      <div class="trustBar" role="list" aria-label="Trust artifacts">
        <a href="/security" role="listitem">Security controls</a>
        <a href="/dpa" role="listitem">DPA template</a>
        <a href="/privacy" role="listitem">Privacy policy</a>
        <a href="/legal" role="listitem">Legal terms</a>
        <a href="/developer-docs" role="listitem">Integration docs</a>
      </div>
    </section>

    <section class="comparison panel reveal" aria-label="Comparison">
      <div class="sectionHead">
        <div class="eyebrow">Comparison</div>
        <h2 class="h2">Compare by execution need</h2>
      </div>

      <div class="table" role="table" aria-label="Pricing comparison matrix">
        <div class="row head" role="row">
          <div class="cell" role="columnheader">Dimension</div>
          <div class="cell" role="columnheader">Audit AI</div>
          <div class="cell" role="columnheader">Pro Audit</div>
          <div class="cell" role="columnheader">OpsMind / Impact</div>
        </div>
        <div class="row" role="row">
          <div class="cell">Primary objective</div>
          <div class="cell">Find leakage</div>
          <div class="cell">Quantify and govern</div>
          <div class="cell">Run at enterprise cadence</div>
        </div>
        <div class="row" role="row">
          <div class="cell">ROI attribution</div>
          <div class="cell">Directional</div>
          <div class="cell">Modeled 90-day window</div>
          <div class="cell">Recurring attribution loop</div>
        </div>
        <div class="row" role="row">
          <div class="cell">Typical timeline</div>
          <div class="cell">Immediate</div>
          <div class="cell">7-10 days</div>
          <div class="cell">Monthly / enterprise term</div>
        </div>
      </div>
    </section>

    <section class="faq panel reveal" aria-label="FAQ">
      <div class="sectionHead">
        <div class="eyebrow">FAQ</div>
        <h2 class="h2">Commercial questions</h2>
      </div>

      <details class="qa" open>
        <summary>Can we contract in INR and USD?</summary>
        <p>Yes. Both currencies are supported and selectable for planning on this page.</p>
      </details>
      <details class="qa">
        <summary>What is the fastest way to measurable value?</summary>
        <p>For most teams, Pro Audit is the fastest structured path to quantified outcomes.</p>
      </details>
      <details class="qa">
        <summary>Can we start small and scale later?</summary>
        <p>Yes. The commercial model is explicitly proof-first and scale-second.</p>
      </details>
    </section>

    <section class="finalCta panel reveal" aria-label="Pricing CTA">
      <div>
        <div class="eyebrow">Next Step</div>
        <h2 class="h2">Start with proof. Scale with confidence.</h2>
      </div>
      <div class="actions">
        <a href="/request-assessment" class="btn btnPrimary" data-track="pricing_footer_start">Start Free AI Audit</a>
        <a href="/contact" class="btn" data-track="pricing_footer_contact">Speak with EraIn</a>
      </div>
    </section>

    <script is:inline>
      (function () {
        const root = document.querySelector(".pricingPage");
        if (!root) return;

        const normalize = (v) => String(v || "").trim().toUpperCase();
        const isCurrency = (v) => v === "INR" || v === "USD";

        const priceNodes = Array.from(root.querySelectorAll(".jsPlanPrice"));
        const currencyButtons = Array.from(root.querySelectorAll("[data-currency-btn]"));
        const billingButtons = Array.from(root.querySelectorAll("[data-billing-btn]"));

        let currency = "INR";
        let billing = "MONTHLY";

        const detectCurrency = () => {
          try {
            const query = normalize(new URL(window.location.href).searchParams.get("currency"));
            if (isCurrency(query)) return query;
          } catch (_) {}

          try {
            const stored = normalize(localStorage.getItem("erain_currency"));
            if (isCurrency(stored)) return stored;
          } catch (_) {}

          const locale = normalize((Intl.NumberFormat().resolvedOptions().locale || navigator.language || "").replace("_", "-"));
          const tz = normalize(Intl.DateTimeFormat().resolvedOptions().timeZone || "");
          const indiaLocale = /(^|-)IN($|-)/.test(locale);
          const indiaTimezone = tz.includes("KOLKATA") || tz.includes("CALCUTTA");
          return indiaLocale || indiaTimezone ? "INR" : "USD";
        };

        const formatMoney = (value) => {
          const n = Math.max(0, Math.round(value));
          if (currency === "USD") {
            return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(n);
          }
          return new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(n);
        };

        const applyPrices = () => {
          priceNodes.forEach((node) => {
            const main = node.querySelector(".moneyMain");
            const alt = node.querySelector(".moneyAlt");
            if (!main || !alt) return;

            const type = String(node.getAttribute("data-price-type") || "one-time");
            if (type === "recurring") {
              if (billing === "ANNUAL") {
                main.textContent = node.getAttribute(currency === "INR" ? "data-year-inr" : "data-year-usd") || "-";
                alt.textContent = node.getAttribute("data-sub-annual") || "annual contract";
              } else {
                main.textContent = node.getAttribute(currency === "INR" ? "data-month-inr" : "data-month-usd") || "-";
                alt.textContent = node.getAttribute("data-sub-monthly") || "per month";
              }
              return;
            }

            main.textContent = node.getAttribute(currency === "INR" ? "data-inr" : "data-usd") || "-";
            alt.textContent = node.getAttribute(currency === "INR" ? "data-sub-inr" : "data-sub-usd") || "";
          });

          currencyButtons.forEach((button) => {
            const on = normalize(button.getAttribute("data-currency-btn")) === currency;
            button.classList.toggle("active", on);
            button.setAttribute("aria-pressed", on ? "true" : "false");
          });

          billingButtons.forEach((button) => {
            const on = normalize(button.getAttribute("data-billing-btn")) === billing;
            button.classList.toggle("active", on);
            button.setAttribute("aria-pressed", on ? "true" : "false");
          });

          try {
            localStorage.setItem("erain_currency", currency);
          } catch (_) {}
        };

        currency = detectCurrency();

        currencyButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const next = normalize(button.getAttribute("data-currency-btn"));
            if (!isCurrency(next)) return;
            currency = next;
            applyPrices();
            runPreview();
          });
        });

        billingButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const next = normalize(button.getAttribute("data-billing-btn"));
            if (next !== "MONTHLY" && next !== "ANNUAL") return;
            billing = next;
            applyPrices();
          });
        });

        applyPrices();

        const buyerData = {
          cfo: {
            title: "CFO Lens",
            text: "Prioritize payback speed and attribution confidence before scaling recurring spend.",
            items: ["Modeled value window", "Owner-linked accountability", "Controlled expansion trigger"],
          },
          coo: {
            title: "COO Lens",
            text: "Prioritize cycle-time recovery and disciplined weekly action closure.",
            items: ["Governed decision cadence", "Execution owner mapping", "Cross-functional drift control"],
          },
          cto: {
            title: "CTO Lens",
            text: "Prioritize integration reliability, traceability, and deployment fit.",
            items: ["System-to-decision trace", "Role-scoped controls", "Deployment flexibility"],
          },
          procurement: {
            title: "Procurement Lens",
            text: "Prioritize legal clarity, controls posture, and contract readiness.",
            items: ["Security artifacts", "DPA and legal template", "Global billing model"],
          },
        };

        const buyerTabs = Array.from(root.querySelectorAll(".buyerTab"));
        const buyerResult = root.querySelector("#buyerResult");

        const renderBuyer = (key) => {
          const data = buyerData[key] || buyerData.cfo;
          if (!buyerResult) return;
          buyerResult.innerHTML = `
            <h3>${data.title}</h3>
            <p>${data.text}</p>
            <ul>${data.items.map((item) => `<li>${item}</li>`).join("")}</ul>
          `;
        };

        buyerTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const key = String(tab.getAttribute("data-buyer") || "cfo");
            buyerTabs.forEach((node) => {
              const active = node === tab;
              node.classList.toggle("active", active);
              node.setAttribute("aria-selected", active ? "true" : "false");
            });
            renderBuyer(key);
          });
        });

        renderBuyer("cfo");

        const leakSlider = root.querySelector("#leakSlider");
        const leakOut = root.querySelector("#leakOut");
        const previewPlan = root.querySelector("#previewPlan");
        const previewReason = root.querySelector("#previewReason");
        const previewRecovery = root.querySelector("#previewRecovery");
        const previewPayback = root.querySelector("#previewPayback");

        const runPreview = () => {
          const units = Number(leakSlider && leakSlider.value ? leakSlider.value : 120);
          const base = currency === "USD" ? units * 10000 : units * 100000;

          if (leakOut) leakOut.textContent = formatMoney(base);

          let plan = "EraIn Pro Audit";
          let reason = "Strong candidate for quantified pilot before recurring cadence.";
          if (base < (currency === "USD" ? 120000 : 15000000)) {
            plan = "EraIn Audit AI";
            reason = "Start with fast visibility and prioritize the first recovery moves.";
          } else if (base > (currency === "USD" ? 900000 : 90000000)) {
            plan = "EraIn OpsMind";
            reason = "Recovery potential justifies recurring operating cadence and governance controls.";
          }

          const recovery = base * 0.22;
          const payback = base > (currency === "USD" ? 900000 : 90000000) ? "8-10 weeks" : "9-12 weeks";

          if (previewPlan) previewPlan.textContent = plan;
          if (previewReason) previewReason.textContent = reason;
          if (previewRecovery) previewRecovery.textContent = formatMoney(recovery);
          if (previewPayback) previewPayback.textContent = payback;
        };

        leakSlider && leakSlider.addEventListener("input", runPreview);
        runPreview();
      })();
    </script>

    <script type="application/ld+json" is:inline>{faqJsonLd}</script>
  </section>

  <style>
    .pricingPageWrap {
      width: 100%;
    }

    .pricingPage {
      max-width: 1380px;
      margin: 0 auto;
      display: grid;
      gap: 20px;
      padding-bottom: 30px;
    }

    .panel {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.84);
      box-shadow: 0 16px 42px rgba(2, 10, 32, 0.08);
      padding: clamp(18px, 2.4vw, 30px);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      border: 1px solid rgba(15, 23, 42, 0.14);
      border-radius: 999px;
      padding: 6px 12px;
      color: rgba(15, 23, 42, 0.62);
      font-size: 10px;
      font-weight: 840;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.72);
    }

    .hero {
      display: grid;
      gap: 16px;
      align-items: start;
      background:
        radial-gradient(980px 360px at -10% -28%, rgba(36, 90, 223, 0.12), transparent 72%),
        radial-gradient(980px 360px at 110% -20%, rgba(10, 140, 184, 0.12), transparent 72%),
        rgba(255, 255, 255, 0.84);
    }

    .heroTitle {
      margin: 12px 0 0;
      color: rgba(15, 23, 42, 0.96);
      font-size: clamp(44px, 6vw, 82px);
      line-height: 0.92;
      letter-spacing: -0.05em;
      font-weight: 860;
      max-width: 11ch;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .heroTitle .displaySerif {
      font-size: 1.03em;
      letter-spacing: -0.02em;
      color: #173d88;
    }

    .heroLead {
      margin: 14px 0 0;
      color: rgba(15, 23, 42, 0.72);
      font-size: clamp(17px, 1.8vw, 21px);
      line-height: 1.56;
      max-width: 66ch;
    }

    .heroStats {
      margin-top: 14px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .stat {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.76);
      padding: 10px;
      display: grid;
      gap: 4px;
    }

    .k {
      color: rgba(15, 23, 42, 0.58);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 820;
    }

    .v {
      color: rgba(15, 23, 42, 0.9);
      font-size: 16px;
      font-weight: 760;
      line-height: 1.3;
    }

    .heroRight {
      display: grid;
      gap: 10px;
      align-content: start;
    }

    .heroControl,
    .recommended {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.8);
      padding: 12px;
      display: grid;
      gap: 8px;
    }

    .recommended {
      border-color: rgba(36, 90, 223, 0.26);
      background:
        radial-gradient(620px 220px at -8% -26%, rgba(36, 90, 223, 0.08), transparent 76%),
        rgba(255, 255, 255, 0.9);
    }

    .recommended h2 {
      margin: 2px 0 0;
      color: rgba(15, 23, 42, 0.92);
      font-size: clamp(24px, 2.2vw, 32px);
      line-height: 1.04;
      letter-spacing: -0.03em;
    }

    .recommended p,
    .heroControl p {
      margin: 0;
