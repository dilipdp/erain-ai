---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "EraIn Solutions — Audit‑First Intelligence for Real Operations";
const description =
  "Outcome-driven offerings for any industry — manufacturing, services, retail, logistics, healthcare, construction, finance, SaaS, and more — that reveal value leaks, quantify impact, and drive disciplined execution.";
---

<BaseLayout title={title} description={description}>
  <section class="sol">
    <div class="solWrap">
      <!-- Hero -->
      <header class="solHero">
        <h1 class="solTitle"><span class="solTitleBrand">EraIn</span> <span class="solTitleDim">Solutions</span></h1>

        <div class="badgeRow solBadges" aria-label="Positioning pillars">
          <span class="badge badgeSoft">All industries</span>
          <span class="badge badgeSoft">Truth-first</span>
          <span class="badge badgeSoft">Proof-based</span>
          <span class="badge badgeSoft">Measurable ROI</span>
          <span class="badge badgeSoft">Execution-grade</span>
        </div>

        <p class="solIndustryLine" aria-label="Industries we serve">
          Manufacturing • Services • Retail • Logistics • Healthcare • Construction • Finance • SaaS • Education • Public sector
        </p>

        <p class="lead solLead">
          EraIn turns verified reality into decisions — and decisions into disciplined delivery.
          We serve <strong>all industries</strong> and functions — wherever margins, quality, speed, compliance, and execution matter.
          Manufacturing, services, retail, logistics, healthcare, construction, finance, SaaS — and beyond.
          Start with an audit; upgrade only when ROI is obvious.
        </p>

        <div class="solIntro">
          <p class="solIntroP">
            EraIn is an <strong>audit-first execution partner</strong>.
            We help teams <strong>see the truth, quantify impact, assign owners, and deliver outcomes</strong> — in that order.
            Whether you run one site or many, we build a repeatable operating cadence that compounds results.
          </p>
          <div class="solMantras" aria-label="Operating principles">
            <div class="solMantra">No dashboards for vanity.</div>
            <div class="solMantra">No AI experiments without ownership.</div>
            <div class="solMantra"><strong>AI built to run operations.</strong></div>
          </div>
        </div>

        <div class="btn-row solHeroCtas" aria-label="Primary actions">
          <a class="btn btnPrimary" href="/request-assessment">Start Free AI Audit</a>
          <a class="btn" href="/pricing">See Pricing</a>
          <a class="btn" href="/sample-report">View Sample Report</a>
        </div>
      </header>

      <section class="solSignalBoard" aria-label="Execution signal board">
        <div class="solSignalHead">
          <div class="solSignalKicker">Execution Signal Board</div>
          <h2 class="solSignalTitle">From operational truth to controlled outcomes.</h2>
        </div>

        <div class="solVisualStage">
          <img
            src="/erain-command-board.svg"
            alt="EraIn command board mapping audit, governance, and ROI signals."
            width="1600"
            height="920"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="solSignalGrid" role="list" aria-label="Signal modules">
          <article class="solSignalCard" role="listitem">
            <div class="solSignalLabel">Auditability</div>
            <div class="solSignalValue">97%+ evidence coverage</div>
            <div class="solSignalText">Findings mapped to source paths before rollout decisions.</div>
            <div class="solSignalBar"><span style="--solFill:97%"></span></div>
          </article>

          <article class="solSignalCard" role="listitem">
            <div class="solSignalLabel">Decision Governance</div>
            <div class="solSignalValue">100% owner mapping</div>
            <div class="solSignalText">Approvals, owners, and execution boundaries set pre-deployment.</div>
            <div class="solSignalBar"><span style="--solFill:100%"></span></div>
          </article>

          <article class="solSignalCard" role="listitem">
            <div class="solSignalLabel">ROI Attribution</div>
            <div class="solSignalValue">Value ledger enabled</div>
            <div class="solSignalText">Action-to-outcome attribution to prove impact with leadership clarity.</div>
            <div class="solSignalBar"><span style="--solFill:86%"></span></div>
          </article>
        </div>
      </section>

      <!-- Sequence -->
      <section class="solSection">
        <div class="solMeasure">
          <h2 class="solH2">One clear path from insight to execution</h2>
          <p class="solP">
            EraIn is not a bundle of tools. It is a deliberate operating sequence — designed to move teams from clarity
            to compounding results.
          </p>
        </div>

        <div class="solSequence" role="list" aria-label="EraIn operating sequence">
          <div class="solStep" role="listitem">
            <div class="solStepTitle">Truth</div>
            <div class="solStepText">What is real</div>
          </div>
          <div class="solStep" role="listitem">
            <div class="solStepTitle">Decisions</div>
            <div class="solStepText">What matters most</div>
          </div>
          <div class="solStep" role="listitem">
            <div class="solStepTitle">Execution</div>
            <div class="solStepText">Who does what, by when</div>
          </div>
          <div class="solStep" role="listitem">
            <div class="solStepTitle">Impact</div>
            <div class="solStepText">What changed — provably</div>
          </div>
        </div>

        <div class="solMeasure">
          <p class="solP" style="margin-top:12px">
            Clients move from <strong>clarity → confidence → execution → compounding results</strong>.
          </p>
        </div>
      </section>

      <!-- Trust + Offerings -->
      <section class="solSection">
        <div class="solTrust" role="note" aria-label="Trust and privacy">
          <div class="solTrustItem">
            <div class="solTrustTitle">Privacy-first</div>
            <div class="solTrustText">Start from Excel/Tally/ERP without invasive access. Your data stays yours.</div>
          </div>
          <div class="solTrustItem">
            <div class="solTrustTitle">Proof over promises</div>
            <div class="solTrustText">We quantify impact and map root causes before recommending rollouts.</div>
          </div>
          <div class="solTrustItem">
            <div class="solTrustTitle">Built for leaders</div>
            <div class="solTrustText">Executive-ready outputs, clear owners, and cadence that makes execution real.</div>
          </div>
        </div>

        <div class="solCards" aria-label="EraIn offerings">
          <div class="card solCard">
            <div class="kicker">Start</div>
            <h3 class="solH3">EraIn Audit AI™</h3>
            <p class="solCardP">Free entry audit that surfaces leaks and produces a 30/60/90 roadmap.</p>
            <a class="btn btnPrimary" href="/request-assessment">Start Free AI Audit</a>
          </div>

          <div class="card solCard">
            <div class="kicker">Quantify</div>
            <h3 class="solH3">EraIn Pro Audit™</h3>
            <p class="solCardP">Deep-dive engagement to quantify losses, map root causes, and produce a 90‑day plan.</p>
            <a class="btn" href="/pricing">View Pricing</a>
          </div>

          <div class="card solCard">
            <div class="kicker">Operate</div>
            <h3 class="solH3">EraIn OpsMind™</h3>
            <p class="solCardP">Monthly operating cadence with monitoring, decision briefs, and execution discipline.</p>
            <a class="btn" href="/contact?upgrade=opsmind">Talk About OpsMind</a>
          </div>

          <div class="card solCard">
            <div class="kicker">Scale</div>
            <h3 class="solH3">EraIn Impact AI™</h3>
            <p class="solCardP">Enterprise rollout with ROI attribution, governance, and long-term intelligence memory.</p>
            <a class="btn" href="/contact?upgrade=impact">Talk to Us</a>
          </div>
        </div>
      </section>

      <hr class="solDivider" />

      <!-- Detailed plans -->
      <section class="solSection">
        <div class="solMeasure">
          <h2 class="solPlanH">1) EraIn Audit AI™ <span class="solTag">Free entry audit</span></h2>
          <p class="solP">
            A consulting-grade <strong>AI Business &amp; Operations Audit</strong> that exposes where money, time, and
            decisions are leaking.
          </p>
          <p class="solP">This is how most companies start with EraIn.</p>
          <p class="solP"><strong>Output:</strong> ranked findings + 30/60/90 roadmap + executive-ready PDF.</p>

          <h3 class="solSubH">What it delivers</h3>
          <ul class="solList">
            <li>Ranked operational and cost leakages</li>
            <li>Clear problem → impact mapping</li>
            <li>A practical <strong>30 / 60 / 90 day</strong> action roadmap</li>
            <li>Industry-aware insights (manufacturing, services, retail, logistics, healthcare, construction)</li>
          </ul>

          <h3 class="solSubH">Best for</h3>
          <ul class="solList">
            <li>Owners &amp; CXOs seeking clarity</li>
            <li>First-time AI adoption</li>
            <li>Establishing a factual baseline before decisions</li>
          </ul>

          <hr class="solDivider" />

          <h2 class="solPlanH">2) EraIn Pro Audit™ <span class="solTag solTagPaid">Paid engagement</span></h2>
          <p class="solP">
            For leadership teams that need <strong>proof, numbers, and confidence</strong> before committing people or
            capital.
          </p>

          <h3 class="solSubH">Adds</h3>
          <ul class="solList">
            <li>Deep root-cause analysis of top value leaks</li>
            <li>₹ / $ impact estimation and recovery potential</li>
            <li>Prioritized execution plan</li>
            <li>Executive-ready audit report</li>
            <li>Executive walkthrough + rollout alignment</li>
          </ul>

          <h3 class="solSubH">Best for</h3>
          <ul class="solList">
            <li>CEOs, COOs, leadership teams</li>
            <li>Cost reset, scale, or turnaround phases</li>
            <li>Board-level decision support</li>
          </ul>

          <hr class="solDivider" />

          <h2 class="solPlanH">3) EraIn OpsMind™ <span class="solTag">Monthly retainer</span></h2>
          <blockquote class="solNote">
            EraIn stops advising — and starts operating with you. OpsMind™ is offered <strong>only after a Pro Audit</strong>,
            ensuring decisions are grounded in verified reality.
          </blockquote>

          <p class="solP">
            An AI-powered <strong>operations &amp; decision copilot</strong> that turns audit insights into daily execution
            discipline.
          </p>

          <h3 class="solSubH">What it does</h3>
          <ul class="solList">
            <li>KPI automation &amp; monitoring</li>
            <li>Early-warning signals for delays, losses, and risks</li>
            <li>Weekly decision insights for ops and leadership</li>
            <li>Structured follow-ups on audit actions</li>
          </ul>

          <h3 class="solSubH">Outcome</h3>
          <ul class="solList">
            <li>Faster decisions</li>
            <li>Fewer surprises</li>
            <li>Sustained margin improvement</li>
            <li>Lower decision latency across teams</li>
          </ul>

          <hr class="solDivider" />

          <h2 class="solPlanH">4) EraIn Impact AI™ <span class="solTag">Enterprise / scale</span></h2>
          <p class="solP">AI systems that <strong>measure, prove, and compound business impact</strong> — permanently.</p>

          <h3 class="solSubH">Capabilities</h3>
          <ul class="solList">
            <li>Outcome tracking tied to actions &amp; decisions</li>
            <li>Financial impact attribution</li>
            <li>Executive visibility across functions</li>
            <li>Long-term organizational intelligence memory</li>
            <li>Decision Engine™ integration for scenario modeling and prioritization</li>
          </ul>

          <h3 class="solSubH">Engagement</h3>
          <ul class="solList">
            <li>Custom-scoped, multi-quarter</li>
            <li>Deep integration with leadership workflows</li>
            <li>Enterprise-grade delivery and governance</li>
          </ul>

          <hr class="solDivider" />

          <h2 class="solH2">How companies typically engage EraIn</h2>
          <ol class="solList" style="padding-left:20px">
            <li>Start with <strong>EraIn Audit AI™</strong></li>
            <li>Upgrade to <strong>Pro Audit™</strong> for quantified clarity</li>
            <li>Deploy <strong>OpsMind™</strong> for disciplined execution</li>
            <li>Scale outcomes with <strong>Impact AI™</strong></li>
          </ol>

          <p class="solP">
            This sequence is deliberate. Skipping steps increases risk, reduces adoption, and breaks ROI attribution.
            It protects trust, leadership credibility, and long-term outcomes.
          </p>

          <div class="btn-row" style="margin-top:14px">
            <a class="btn btnPrimary" href="/request-assessment">Start Free AI Audit</a>
            <a class="btn" href="/pricing">See Pricing</a>
            <a class="btn" href="/sample-report">View Sample Report</a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="solSection">
        <div class="solMeasure">
          <h2 class="solH2">FAQ</h2>
          <details class="qa" open>
            <summary>What do I get in the Free Audit?</summary>
            <p>Ranked findings, key risks, and a 30/60/90-day roadmap — plus an executive-ready summary.</p>
          </details>
          <details class="qa">
            <summary>When should I upgrade to Pro Audit?</summary>
            <p>
              When you want quantified impact estimates, root-cause analysis, and a 90-day execution plan before
              committing internal resources.
            </p>
          </details>
          <details class="qa">
            <summary>Is OpsMind a product or a service?</summary>
            <p>
              OpsMind is a productized operating cadence: monitoring and briefs where needed, plus execution discipline
              that drives outcomes.
            </p>
          </details>
          <details class="qa">
            <summary>Can you work with Excel/Tally and messy data?</summary>
            <p>
              Yes. We start from whatever exists today (Excel, Tally, ERP) and improve data quality as part of the
              execution plan.
            </p>
          </details>
        </div>
      </section>
    </div>
  </section>

  <style>
    /*
      Root cause of your screenshot:
      - BaseLayout likely has a global `.section` class (used across pages) that creates multi-column layouts.
      - This page used `.section` too, so your content was being laid out into unwanted columns.
      Fix:
      - Use page-specific classes (`.solSection`, `.solWrap`) and force a single consistent container.
    */

    .sol {
      padding-top: 10px;
    }

    .solWrap {
      /* BaseLayout already provides a centered container — avoid double-centering + cramped measure */
      max-width: none;
      margin: 0;
      padding: 0;
    }

    .solSection {
      margin-top: 42px;
    }

    .solSignalBoard {
      max-width: 1120px;
      margin: 10px auto 0;
      border: 1px solid rgba(11, 31, 66, 0.14);
      border-radius: 26px;
      background:
        linear-gradient(145deg, rgba(7, 24, 56, 0.96), rgba(9, 39, 86, 0.92) 56%, rgba(8, 27, 62, 0.94));
      box-shadow: 0 26px 72px rgba(2, 10, 32, 0.22);
      color: #eaf5ff;
      padding: 18px;
    }

    .solSignalHead {
      max-width: 86ch;
    }

    .solSignalKicker {
      display: inline-flex;
      border: 1px solid rgba(148, 206, 255, 0.44);
      border-radius: 999px;
      background: rgba(10, 49, 104, 0.48);
      color: rgba(200, 234, 255, 0.94);
      padding: 7px 11px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .solSignalTitle {
      margin: 10px 0 0;
      font-size: clamp(27px, 3.2vw, 38px);
      line-height: 1.08;
      letter-spacing: -0.03em;
      font-weight: 900;
      color: rgba(241, 249, 255, 0.98);
    }

    .solSignalGrid {
      margin-top: 14px;
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }

    .solVisualStage {
      margin-top: 12px;
      border: 1px solid rgba(134, 191, 255, 0.38);
      border-radius: 22px;
      overflow: hidden;
      background:
        linear-gradient(145deg, rgba(7, 24, 56, 0.98), rgba(9, 39, 86, 0.95) 56%, rgba(8, 27, 62, 0.96));
      box-shadow: 0 22px 52px rgba(2, 10, 32, 0.26);
    }

    .solVisualStage img {
      display: block;
      width: 100%;
      height: auto;
      filter: saturate(1.04) contrast(1.04);
    }

    .solSignalCard {
      border: 1px solid rgba(142, 199, 255, 0.34);
      border-radius: 18px;
      background: rgba(6, 28, 66, 0.56);
      padding: 12px 13px;
    }

    .solSignalLabel {
      color: rgba(175, 222, 255, 0.94);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .solSignalValue {
      margin-top: 6px;
      color: rgba(241, 249, 255, 0.98);
      font-size: 24px;
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-weight: 840;
    }

    .solSignalText {
      margin-top: 6px;
      color: rgba(190, 216, 241, 0.9);
      font-size: 13px;
      line-height: 1.56;
    }

    .solSignalBar {
      margin-top: 11px;
      height: 6px;
      border-radius: 999px;
      background: rgba(132, 190, 255, 0.24);
      overflow: hidden;
    }

    .solSignalBar span {
      display: block;
      width: var(--solFill, 75%);
      height: 100%;
      border-radius: inherit;
      background:
        linear-gradient(90deg, rgba(132, 230, 255, 0.95), rgba(101, 157, 255, 0.92) 58%, rgba(104, 236, 206, 0.9));
      animation: solSignalPulse 4.2s ease-in-out infinite;
    }

    @keyframes solSignalPulse {
      0% { filter: brightness(0.9); }
      50% { filter: brightness(1.08); }
      100% { filter: brightness(0.9); }
    }

    /* Add deliberate spacing between hero and the first content section */
    .solHero + .solSection {
      margin-top: 52px;
    }

    .solMeasure {
      max-width: 78ch;
      margin-left: auto;
      margin-right: auto;
    }

    /* Hero */
    .solHero {
      text-align: center;
      padding: 22px 0 30px; /* calmer vertical rhythm */
      max-width: 980px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .solKicker {
      margin: 0;
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(17, 24, 39, 0.56);
    }

    .solTitle {
      margin: 6px 0 0;
      font-size: clamp(40px, 4.8vw, 66px);
      line-height: 1.02;
      letter-spacing: -0.045em;
      font-weight: 900;
      color: rgba(2, 6, 23, 0.94);
    }

    .solTitleDim {
      color: rgba(2, 6, 23, 0.70);
      font-weight: 800;
    }

    .solBadges {
      justify-content: center;
      margin: 14px 0 0;
      gap: 10px;
      flex-wrap: wrap;
    }

    .solIndustryLine {
      margin: 10px auto 0;
      max-width: 92ch;
      font-size: 13px;
      line-height: 1.55;
      color: rgba(17, 24, 39, 0.58);
    }

    .solTitleBrand {
      color: rgba(2, 6, 23, 0.94);
      font-weight: 900;
      letter-spacing: -0.045em;
    }

    .solLead {
      margin-left: auto;
      margin-right: auto;
      max-width: 76ch;
      font-size: 19px;
      line-height: 1.85;
      color: rgba(17, 24, 39, 0.74);
    }

    .solIntro {
      margin-top: 14px;
      max-width: 74ch;
      margin-left: auto;
      margin-right: auto;
    }

    .solIntroP {
      margin: 10px 0 0;
      font-size: 16px;
      line-height: 1.85;
      color: rgba(17, 24, 39, 0.72);
    }

    .solMantras {
      margin-top: 14px;
      display: grid;
      gap: 8px;
    }

    .solMantra {
      color: rgba(17, 24, 39, 0.66);
      font-size: 15px;
      line-height: 1.7;
    }

    .solHeroCtas {
      justify-content: center;
      margin-top: 16px;
      margin-bottom: 10px; /* ensures shadows don’t visually slice into the next section */
      position: relative;
      z-index: 3;
    }

    /* Prevent any paint/compositing artifacts from button shadows */
    .solHeroCtas .btn {
      transform: translateZ(0);
    }

    /* Type */
    .solH2 {
      margin: 0 0 10px;
      font-size: clamp(24px, 2.4vw, 34px);
      line-height: 1.14;
      letter-spacing: -0.03em;
      font-weight: 900;
      color: rgba(2, 6, 23, 0.92);
    }

    .solP {
      margin: 0;
      font-size: 16px;
      line-height: 1.85;
      color: rgba(17, 24, 39, 0.72);
    }

    /* Sequence */
    .solSequence {
      margin-top: 14px;
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr;
      max-width: 980px;
      margin-left: auto;
      margin-right: auto;
    }

    @media (min-width: 860px) {
      .solSequence {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .solSignalGrid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .solStep {
      border: 1px solid rgba(17, 24, 39, 0.10);
      background: rgba(255, 255, 255, 0.86);
      border-radius: 18px;
      padding: 14px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 16px 40px rgba(2, 6, 23, 0.06);
      text-align: left;
    }

    .solStepTitle {
      font-weight: 900;
      letter-spacing: -0.02em;
      color: rgba(2, 6, 23, 0.90);
      font-size: 15px;
    }

    .solStepText {
      margin-top: 6px;
      color: rgba(17, 24, 39, 0.64);
      font-size: 14px;
      line-height: 1.65;
    }

    /* Trust */
    .solTrust {
      display: grid;
      gap: 14px;
      grid-template-columns: 1fr;
      max-width: 1120px;
      margin: 0 auto;
    }

    @media (min-width: 980px) {
      .solTrust {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .solTrustItem {
      border: 1px solid rgba(17, 24, 39, 0.10);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.86);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 18px 50px rgba(2, 6, 23, 0.07);
      padding: 16px;
      text-align: left;
    }

    .solTrustTitle {
      font-weight: 900;
      letter-spacing: -0.01em;
      color: rgba(2, 6, 23, 0.88);
      font-size: 15px;
    }

    .solTrustText {
      margin-top: 8px;
      color: rgba(17, 24, 39, 0.66);
      line-height: 1.85;
      font-size: 15px;
    }

    /* Offerings */
    .solCards {
      margin-top: 16px;
      display: grid;
      gap: 14px;
      grid-template-columns: 1fr;
      max-width: 1120px;
      margin-left: auto;
      margin-right: auto;
    }

    @media (min-width: 980px) {
      .solCards {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .solCard {
      padding: 18px;
      border-radius: 22px;
    }

    .solH3 {
      margin: 10px 0 6px;
      font-size: 18px;
      line-height: 1.28;
      letter-spacing: -0.02em;
      font-weight: 900;
      color: rgba(2, 6, 23, 0.92);
    }

    .solCardP {
      margin: 0 0 14px;
      color: rgba(17, 24, 39, 0.70);
      line-height: 1.85;
      font-size: 15.5px;
    }

    /* Plans */
    .solPlanH {
      margin: 0;
      font-size: clamp(22px, 2.1vw, 30px);
      line-height: 1.18;
      letter-spacing: -0.03em;
      font-weight: 900;
      color: rgba(2, 6, 23, 0.92);
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .solTag {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      border: 1px solid rgba(17, 24, 39, 0.12);
      background: rgba(255, 255, 255, 0.86);
      color: rgba(17, 24, 39, 0.70);
      padding: 7px 10px;
