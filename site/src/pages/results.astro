---
import BaseLayout from "../layouts/BaseLayout.astro";
import caseStudiesCsvRaw from "../../ops/no1/trackers/case-studies.csv?raw";
import scoreboardCsvRaw from "../../ops/no1/trackers/scoreboard-weekly.csv?raw";
import revenueCsvRaw from "../../ops/no1/trackers/revenue-weekly.csv?raw";

const title = "Results — EraIn AI";
const description =
  "Representative operating outcomes from audit-first engagements: governance gains, execution recovery, and ROI attribution patterns.";

function readCsv(rawCsv = "") {
  const raw = String(rawCsv || "").trim();
  if (!raw) return [];
  const lines = raw.split(/\r?\n/).filter(Boolean);
  if (lines.length < 2) return [];
  const headers = lines[0].split(",").map((v) => v.trim());
  return lines.slice(1).map((line) => {
    const values = line.split(",");
    const row = {};
    for (let i = 0; i < headers.length; i += 1) {
      row[headers[i]] = (values[i] || "").trim();
    }
    return row;
  });
}

function toNumber(value) {
  const n = Number(String(value).trim());
  return Number.isFinite(n) ? n : NaN;
}

function latestByWeek(rows, field = "week_start_iso") {
  if (!rows.length) return null;
  return [...rows].sort((a, b) => Date.parse(a[field] || "") - Date.parse(b[field] || "")).at(-1) || null;
}

function formatCr(valueInr) {
  const cr = valueInr / 10000000;
  return cr.toFixed(cr >= 10 ? 1 : 2).replace(/\.00$/, "").replace(/(\.\d)0$/, "$1");
}

function formatUsdCompact(usd) {
  if (usd >= 1000000) {
    return `$${(usd / 1000000).toFixed(2).replace(/\.00$/, "")}M`;
  }
  return `$${Math.round(usd / 1000)}k`;
}

function formatWeekLabel(weekIso) {
  if (!weekIso) return "Latest review";
  const date = new Date(`${weekIso}T00:00:00Z`);
  if (!Number.isFinite(date.getTime())) return "Latest review";
  return date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
}

function extractPercent(text) {
  const match = String(text || "").match(/-?\d+(\.\d+)?/);
  if (!match) return NaN;
  const value = Number(match[0]);
  return Number.isFinite(value) ? Math.abs(value) : NaN;
}

const caseRows = readCsv(caseStudiesCsvRaw);
const scoreRows = readCsv(scoreboardCsvRaw);
const revenueRows = readCsv(revenueCsvRaw);

const latestScore = latestByWeek(scoreRows);
const latestRevenue = latestByWeek(revenueRows);
const latestWeekIso = latestScore?.week_start_iso || latestRevenue?.week_start_iso || "";
const latestWeekLabel = formatWeekLabel(latestWeekIso);

const caseCount = caseRows.length;
const namedCaseCount = caseRows.filter((row) => String(row.named_client_approved || "").toLowerCase() === "yes").length;

const proofBadge = namedCaseCount > 0 ? "Named + anonymized proof" : "Anonymized proof";
const releaseMeta = `Representative operating signal map · ${latestWeekLabel}`;

const pipelineInr = toNumber(latestScore?.weekly_new_pipeline_inr || latestRevenue?.new_pipeline_inr || 0);
const pipelineLabel = Number.isFinite(pipelineInr) && pipelineInr > 0 ? `INR ${formatCr(pipelineInr)} Cr` : "INR n/a";

const percentValues = caseRows.map((row) => extractPercent(row.measured_delta)).filter((v) => Number.isFinite(v));
let executionRecoveryLabel = "15-31%";
if (percentValues.length > 0) {
  const min = Math.min(...percentValues);
  const max = Math.max(...percentValues);
  executionRecoveryLabel = min === max ? `${min}%` : `${min}%-${max}%`;
}

const impactValues = caseRows
  .map((row) => toNumber(row.annualized_impact_inr))
  .filter((v) => Number.isFinite(v) && v > 0);
let recoveryPathInrLabel = "INR 1.2 Cr-4.6 Cr";
let recoveryPathUsdLabel = "Approx USD 145k-554k";
if (impactValues.length > 0) {
  const min = Math.min(...impactValues);
  const max = Math.max(...impactValues);
  const fxRate = 83;
  const minUsd = min / fxRate;
  const maxUsd = max / fxRate;
  recoveryPathInrLabel = min === max ? `INR ${formatCr(min)} Cr` : `INR ${formatCr(min)} Cr-${formatCr(max)} Cr`;
  recoveryPathUsdLabel = min === max ? `Approx USD ${formatUsdCompact(minUsd)}` : `Approx USD ${formatUsdCompact(minUsd)}-${formatUsdCompact(maxUsd)}`;
}

const responseSla = toNumber(latestScore?.lead_response_sla_percent);
const responseSlaLabel = Number.isFinite(responseSla) ? `${responseSla}%` : "n/a";
const namedRatioLabel = caseCount > 0 ? `${namedCaseCount}/${caseCount}` : "0/0";

const resultsJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "EraIn Results",
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "EraIn AI",
    url: "https://erainai.com",
  },
});
---

<BaseLayout title={title} description={description}>
  <section class="resultsV2">
    <header class="resultsHero reveal">
      <div class="resultsCopy">
        <div class="badgeRow">
          <span class="badge badgeSoft">{proofBadge}</span>
          <span class="badge badgeSoft">Owner-mapped execution</span>
          <span class="badge badgeSoft">ROI attribution</span>
        </div>

        <h1 class="h1 resultsTitle">Results leadership can verify.</h1>
        <p class="lead resultsLead">
          EraIn programs are measured on operating movement, not AI activity. Public pages stay anonymized until client approval,
          but every result here maps to evidence-linked execution records.
        </p>

        <div class="signalGrid" role="list" aria-label="Results headline signals">
          <article class="signalCard" role="listitem">
            <div class="signalK">Proof records</div>
            <div class="signalV">{caseCount}</div>
            <div class="signalT">Tracked proof packs in the current ledger.</div>
          </article>
          <article class="signalCard" role="listitem">
            <div class="signalK">Named references</div>
            <div class="signalV">{namedRatioLabel}</div>
            <div class="signalT">Named approvals against total evidence packs.</div>
          </article>
          <article class="signalCard" role="listitem">
            <div class="signalK">Latest pipeline</div>
            <div class="signalV">{pipelineLabel}</div>
            <div class="signalT">Most recent weekly pipeline reported in the ops tracker.</div>
          </article>
        </div>
      </div>

      <aside class="resultsMedia">
        <div class="resultsVisualShell">
          <img
            src="/erain-results-cosmos.svg"
            alt="EraIn results map connecting execution metrics to measurable outcomes"
            width="1600"
            height="940"
            loading="eager"
            decoding="async"
          />
        </div>
        <p class="resultsMeta">{releaseMeta}</p>
      </aside>
    </header>

    <section class="bands reveal" aria-label="Outcome bands">
      <article class="bandCard">
        <div class="bandK">Execution recovery</div>
        <div class="bandV">{executionRecoveryLabel}</div>
        <p>Observed reduction range in cycle drift and execution volatility.</p>
      </article>
      <article class="bandCard">
        <div class="bandK">Response discipline</div>
        <div class="bandV">{responseSlaLabel}</div>
        <p>Current SLA discipline from weekly operating reviews.</p>
      </article>
      <article class="bandCard">
        <div class="bandK">Recovery path</div>
        <div class="bandV">{recoveryPathInrLabel}</div>
        <div class="bandSub">{recoveryPathUsdLabel}</div>
        <p>Attributed value window from audited interventions.</p>
      </article>
    </section>

    <section class="cases reveal" aria-label="Representative case patterns">
      <article class="caseCard">
        <div class="caseMeta">Industrial network · 90-day cycle</div>
        <h2 class="h2">Delay variance stabilized through owner-path governance</h2>
        <p>Audit signals exposed unstable approval queues. Governance mapping restored execution rhythm.</p>
        <div class="caseStats">
          <span>-22% delay variance</span>
          <span>94% evidence coverage</span>
          <span>2.7x faster approvals</span>
        </div>
      </article>
      <article class="caseCard">
        <div class="caseMeta">Logistics + services · 60-day sprint</div>
        <h2 class="h2">Decision drift reduced with weekly control cadence</h2>
        <p>Role accountability and escalation thresholds improved closure speed across cross-functional lanes.</p>
        <div class="caseStats">
          <span>-31% escalation latency</span>
          <span>88% action closure</span>
          <span>3.1x decision velocity</span>
        </div>
      </article>
      <article class="caseCard">
        <div class="caseMeta">Enterprise portfolio · 120-day arc</div>
        <h2 class="h2">Attribution ledger aligned initiatives to measurable value</h2>
        <p>Disconnected workstreams were merged into one accountable value trajectory with executive checkpoints.</p>
        <div class="caseStats">
          <span>INR 4.6 Cr value path</span>
          <span>100% owner mapping</span>
          <span>12-week first window</span>
        </div>
      </article>
    </section>

    <section class="ledger reveal" aria-label="Public proof release ledger">
      <div class="ledgerHead">
        <div class="ledgerEyebrow">Verification Ledger</div>
        <h2 class="h2">Public release status</h2>
      </div>
      <div class="ledgerTable" role="table" aria-label="Proof release table">
        <div class="ledgerRow ledgerRowHead" role="row">
          <div class="ledgerCell" role="columnheader">Evidence pack</div>
          <div class="ledgerCell" role="columnheader">Release state</div>
          <div class="ledgerCell" role="columnheader">Last review</div>
        </div>
        <div class="ledgerRow" role="row">
          <div class="ledgerCell" role="cell">Industrial execution recovery pack</div>
          <div class="ledgerCell" role="cell">Anonymized public release</div>
          <div class="ledgerCell" role="cell">{latestWeekLabel} · Delivery governance</div>
        </div>
        <div class="ledgerRow" role="row">
          <div class="ledgerCell" role="cell">Logistics governance acceleration pack</div>
          <div class="ledgerCell" role="cell">{namedCaseCount > 0 ? "Named release approved" : "Named release pending approval"}</div>
          <div class="ledgerCell" role="cell">{latestWeekLabel} · Program operations</div>
        </div>
        <div class="ledgerRow" role="row">
          <div class="ledgerCell" role="cell">Enterprise attribution proof pack</div>
          <div class="ledgerCell" role="cell">Internal evidence complete</div>
          <div class="ledgerCell" role="cell">{latestWeekLabel} · Impact office</div>
        </div>
      </div>
    </section>

    <section class="reference reveal" aria-label="Reference process">
      <div class="referenceCopy">
        <div class="ledgerEyebrow">Reference Program</div>
        <h2 class="h2">NDA-governed proof access for qualified buyers.</h2>
        <p>
          We provide controlled walkthroughs of governance design, intervention logic, and outcome movement when legal and qualification criteria are met.
        </p>
      </div>
      <div class="referenceActions">
        <a class="btn btnPrimary" href="/contact?topic=reference-program" data-track="results_reference_request">Request reference review</a>
        <a class="btn" href="/sample-report.pdf" download data-track="results_reference_download">Download sample audit pack</a>
      </div>
    </section>
  </section>

  <script type="application/ld+json" is:inline>{resultsJsonLd}</script>

  <style>
    .resultsV2 {
      max-width: 1340px;
      margin: 0 auto;
      display: grid;
      gap: 24px;
      padding-bottom: 20px;
    }

    .resultsHero,
    .bands,
    .cases,
    .ledger,
    .reference {
      border: 1px solid rgba(15, 23, 42, 0.11);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 0 18px 44px rgba(2, 10, 32, 0.08);
      padding: clamp(18px, 3vw, 30px);
    }

    .resultsHero {
      display: grid;
      gap: 18px;
    }

    .resultsCopy,
    .resultsMedia {
      min-width: 0;
    }

    .resultsTitle {
      margin-top: 12px;
      max-width: 16ch;
      font-size: clamp(40px, 7vw, 76px);
      line-height: 0.96;
      letter-spacing: -0.05em;
      font-weight: 860;
    }

    .resultsLead {
      margin-top: 14px;
      max-width: 70ch;
      font-size: clamp(17px, 2vw, 22px);
      line-height: 1.58;
      color: rgba(15, 23, 42, 0.7);
    }

    .signalGrid {
      margin-top: 16px;
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }

    .signalCard {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.74);
      padding: 12px 14px;
    }

    .signalK {
      font-size: 10px;
      font-weight: 860;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.56);
    }

    .signalV {
      margin-top: 5px;
      color: rgba(15, 23, 42, 0.94);
      font-size: 23px;
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-weight: 800;
    }

    .signalT {
      margin-top: 6px;
      color: rgba(15, 23, 42, 0.66);
      font-size: 13px;
      line-height: 1.56;
    }

    .resultsVisualShell {
      border: 1px solid rgba(120, 181, 255, 0.28);
      border-radius: 24px;
      overflow: hidden;
      padding: 8px;
      background: linear-gradient(145deg, rgba(8, 26, 64, 0.96), rgba(9, 38, 82, 0.9));
      box-shadow: 0 30px 64px rgba(2, 10, 32, 0.26);
    }

    .resultsVisualShell img {
      display: block;
      width: 100%;
      border-radius: 16px;
      height: auto;
    }

    .resultsMeta {
      margin: 8px 0 0;
      font-size: 11px;
      font-weight: 760;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.58);
    }

    .bands {
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr;
    }

    .bandCard {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 18px;
      padding: 14px 16px;
      background: linear-gradient(160deg, rgba(15, 23, 42, 0.94), rgba(21, 52, 112, 0.9));
      color: #e7f3ff;
      box-shadow: 0 20px 44px rgba(2, 10, 32, 0.2);
    }

    .bandK {
      font-size: 10px;
      font-weight: 840;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(189, 221, 255, 0.9);
    }

    .bandV {
      margin-top: 8px;
      font-size: clamp(32px, 5vw, 52px);
      line-height: 0.98;
      letter-spacing: -0.04em;
      font-weight: 820;
      color: #f2f8ff;
    }

    .bandSub {
      margin-top: 4px;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(191, 219, 249, 0.82);
      font-weight: 760;
    }

    .bandCard p {
      margin: 8px 0 0;
      color: rgba(208, 229, 250, 0.9);
      font-size: 13px;
      line-height: 1.55;
    }

    .cases {
      display: grid;
      gap: 12px;
      grid-template-columns: 1fr;
    }

    .caseCard {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 18px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.78);
    }

    .caseMeta {
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.56);
      font-weight: 840;
    }

    .caseCard h2 {
      margin-top: 8px;
      font-size: 28px;
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .caseCard p {
      margin: 8px 0 0;
      color: rgba(15, 23, 42, 0.68);
      font-size: 14px;
      line-height: 1.58;
    }

    .caseStats {
      margin-top: 10px;
      display: grid;
      gap: 8px;
    }

    .caseStats span {
      display: inline-flex;
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 999px;
      padding: 7px 11px;
      background: rgba(255, 255, 255, 0.72);
      font-size: 12px;
      font-weight: 760;
      color: rgba(15, 23, 42, 0.78);
      width: fit-content;
    }

    .ledgerHead {
      margin-bottom: 10px;
    }

    .ledgerEyebrow {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(15, 23, 42, 0.16);
      border-radius: 999px;
      padding: 8px 14px;
      color: rgba(15, 23, 42, 0.72);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.72);
    }

    .ledgerTable {
      display: grid;
      gap: 8px;
    }

    .ledgerRow {
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.74);
      padding: 10px;
    }

    .ledgerRowHead {
      background: rgba(15, 23, 42, 0.05);
    }

    .ledgerCell {
      color: rgba(15, 23, 42, 0.75);
      font-size: 13px;
      line-height: 1.5;
    }

    .ledgerRowHead .ledgerCell {
      color: rgba(15, 23, 42, 0.9);
      font-size: 11px;
      font-weight: 840;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .reference {
      display: grid;
      gap: 14px;
      align-items: center;
    }

    .referenceCopy p {
      margin: 10px 0 0;
      color: rgba(15, 23, 42, 0.68);
      font-size: 15px;
      line-height: 1.62;
      max-width: 76ch;
    }

    .referenceActions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    @media (min-width: 980px) {
      .resultsHero {
        grid-template-columns: minmax(0, 1.03fr) minmax(0, 0.97fr);
        align-items: start;
      }

      .signalGrid,
      .bands,
      .cases {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .ledgerRow {
        grid-template-columns: 1fr 0.9fr 1.1fr;
      }

      .reference {
        grid-template-columns: minmax(0, 1fr) auto;
      }
    }

    @media (max-width: 768px) {
      .resultsHero,
      .bands,
      .cases,
      .ledger,
      .reference {
        border-radius: 22px;
        padding: 16px;
      }

      .resultsTitle {
        max-width: 12ch;
      }

      .referenceActions .btn {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
