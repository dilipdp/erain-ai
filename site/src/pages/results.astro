---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Results — EraIn AI";
const description =
  "Representative operating outcomes from audit-first engagements: governance gains, execution recovery, and ROI attribution patterns.";

const resultsJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "EraIn Results",
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "EraIn AI",
    url: "https://erainai.com",
  },
});
---

<BaseLayout title={title} description={description}>
  <section class="results">
    <header class="resHero">
      <div class="resHeroCopy">
        <div class="badgeRow" aria-label="Results positioning">
          <span class="badge badgeSoft">Anonymized proof</span>
          <span class="badge badgeSoft">Owner-mapped execution</span>
          <span class="badge badgeSoft">ROI attribution</span>
          <span class="badge badgeSoft">Launch ledger verified</span>
        </div>

        <h1 class="h1">Results that leadership can verify.</h1>
        <p class="lead">
          EraIn engagements are measured on operating outcomes, not AI activity.
          The patterns below are anonymized until clients approve public naming, but each item maps to evidence-linked execution records.
        </p>

        <div class="resHeroSignalRow" role="list" aria-label="Results signal highlights">
          <div class="resHeroSignal" role="listitem">
            <div class="resHeroSignalK">Verified Evidence</div>
            <div class="resHeroSignalV">94%</div>
            <div class="resHeroSignalT">Average source coverage at decision handoff.</div>
          </div>
          <div class="resHeroSignal" role="listitem">
            <div class="resHeroSignalK">Governance Mapping</div>
            <div class="resHeroSignalV">100%</div>
            <div class="resHeroSignalT">Owner path + approval controls defined before rollout.</div>
          </div>
          <div class="resHeroSignal" role="listitem">
            <div class="resHeroSignalK">Recovery Window</div>
            <div class="resHeroSignalV">12 Weeks</div>
            <div class="resHeroSignalT">First value trajectory made measurable in-cycle.</div>
          </div>
        </div>
      </div>

      <aside class="resHeroMedia">
        <div class="resVisualShell">
          <img
            src="/erain-results-cosmos.svg"
            alt="EraIn results cosmos showing verified outcomes flowing through the execution core."
            width="1600"
            height="940"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="resVisualMeta">Representative operating signal map · February 2026 release</div>
      </aside>
    </header>

    <section class="resBand" aria-label="Outcome bands">
      <article class="resBandCard">
        <div class="resBandK">Execution Recovery</div>
        <div class="resBandV">15–31%</div>
        <div class="resBandT">Reduction in cycle-time drift across first operating windows.</div>
      </article>
      <article class="resBandCard">
        <div class="resBandK">Decision Velocity</div>
        <div class="resBandV">2.3x–3.1x</div>
        <div class="resBandT">Faster approvals and action closure with governance mapping.</div>
      </article>
      <article class="resBandCard">
        <div class="resBandK">Recovery Path</div>
        <div class="resBandV">INR 1.2 Cr–4.6 Cr</div>
        <div class="resBandS">Approx USD 145k-554k</div>
        <div class="resBandT">Attributed value window identified in early deployment cycles.</div>
      </article>
    </section>

    <section class="resCases" aria-label="Representative cases">
      <article class="resCase">
        <div class="resCaseMeta">Industrial network · multi-site · 90-day cycle</div>
        <h2 class="h2">Delay variance stabilized after owner-path redesign</h2>
        <p class="resCaseP">
          Initial audits identified handoff volatility and unresolved approval queues. EraIn installed escalation logic and owner checkpoints.
        </p>
        <div class="resCaseStats">
          <div><strong>-22%</strong><span>delay variance</span></div>
          <div><strong>94%</strong><span>evidence coverage</span></div>
          <div><strong>2.7x</strong><span>faster approvals</span></div>
        </div>
      </article>

      <article class="resCase">
        <div class="resCaseMeta">Logistics + services · multi-city · 60-day sprint</div>
        <h2 class="h2">Execution drift reduced with weekly decision briefs</h2>
        <p class="resCaseP">
          Teams had fragmented priorities. Structured decision governance and action-to-owner tracking improved resolution cadence.
        </p>
        <div class="resCaseStats">
          <div><strong>-31%</strong><span>escalation latency</span></div>
          <div><strong>88%</strong><span>closure rate</span></div>
          <div><strong>3.1x</strong><span>decision velocity</span></div>
        </div>
      </article>

      <article class="resCase">
        <div class="resCaseMeta">Enterprise portfolio · 12 units · 120-day arc</div>
        <h2 class="h2">Attribution ledger aligned initiatives to measurable value</h2>
        <p class="resCaseP">
          Multiple disconnected initiatives were merged into one accountable value map with recurring executive review loops.
        </p>
        <div class="resCaseStats">
          <div><strong>INR 4.6 Cr</strong><span>value path</span></div>
          <div><strong>100%</strong><span>owner mapping</span></div>
          <div><strong>12 weeks</strong><span>first value window</span></div>
        </div>
      </article>
    </section>

    <section class="resLedger" aria-label="Verification ledger">
      <div class="resLedgerHead">
        <div class="resLedgerKicker">Verification Ledger</div>
        <h2 class="h2">Public-proof release status</h2>
      </div>

      <div class="resLedgerTable" role="table" aria-label="Public proof table">
        <div class="resLedgerRow resLedgerRowHead" role="row">
          <div class="resLedgerCell" role="columnheader">Evidence Pack</div>
          <div class="resLedgerCell" role="columnheader">Release State</div>
          <div class="resLedgerCell" role="columnheader">Last Review</div>
        </div>
        <div class="resLedgerRow" role="row">
          <div class="resLedgerCell" role="cell">Industrial execution recovery pack</div>
          <div class="resLedgerCell" role="cell">Anonymized public release</div>
          <div class="resLedgerCell" role="cell">February 23, 2026 · Delivery Governance</div>
        </div>
        <div class="resLedgerRow" role="row">
          <div class="resLedgerCell" role="cell">Logistics governance acceleration pack</div>
          <div class="resLedgerCell" role="cell">Named release pending client approval</div>
          <div class="resLedgerCell" role="cell">February 23, 2026 · Program Operations</div>
        </div>
        <div class="resLedgerRow" role="row">
          <div class="resLedgerCell" role="cell">Enterprise attribution proof pack</div>
          <div class="resLedgerCell" role="cell">Internal evidence complete</div>
          <div class="resLedgerCell" role="cell">February 23, 2026 · Impact AI Office</div>
        </div>
      </div>
    </section>

    <section class="resReference" aria-label="Reference program">
      <div class="resReferenceHead">
        <div class="resReferenceKicker">Reference Program</div>
        <h2 class="h2">Proof access for serious buyers</h2>
        <p class="resReferenceLead">
          Public case naming stays anonymized until client approval. For qualified enterprise evaluations, we run a controlled
          reference desk with NDA-governed proof packs and outcome walkthroughs.
        </p>
      </div>
      <div class="resReferenceGrid" role="list" aria-label="Reference program details">
        <article class="resReferenceCard" role="listitem">
          <div class="resReferenceLabel">Reference format</div>
          <div class="resReferenceValue">NDA-ledger call</div>
          <div class="resReferenceText">Owner-mapped walkthrough of operating baseline, intervention path, and measurable outcome.</div>
        </article>
        <article class="resReferenceCard" role="listitem">
          <div class="resReferenceLabel">Review window</div>
          <div class="resReferenceValue">48-72 hours</div>
          <div class="resReferenceText">Qualification plus legal checks, then evidence-pack scheduling with program owners.</div>
        </article>
        <article class="resReferenceCard" role="listitem">
          <div class="resReferenceLabel">Output package</div>
          <div class="resReferenceValue">Governance + ROI trail</div>
          <div class="resReferenceText">Decision map, execution cadence, and attribution method used to validate impact.</div>
        </article>
      </div>
      <div class="resReferenceActions">
        <a class="btn btnPrimary" href="/contact?topic=reference-program" data-track="results_reference_request">Request reference review</a>
        <a class="btn" href="/sample-report.pdf" download data-track="results_reference_download_pack">Download sample audit pack</a>
      </div>
    </section>

    <section class="resActions" aria-label="Results actions">
      <a class="btn btnPrimary" href="/request-assessment" data-track="results_start_audit">Start Free AI Audit</a>
      <a class="btn" href="/sample-report.pdf" download data-track="results_download_sample_pdf">Download Sample Audit (PDF)</a>
      <a class="btn" href="/contact" data-track="results_contact">Discuss your use case</a>
    </section>
  </section>

  <script type="application/ld+json" is:inline>{resultsJsonLd}</script>

  <style>
    .results {
      max-width: 1240px;
      margin: 0 auto;
      padding: 10px 0 4px;
    }

    .resHero {
      border: 1px solid rgba(11, 31, 66, 0.14);
      border-radius: 28px;
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.95) 0%,
          rgba(246, 251, 255, 0.9) 56%,
          rgba(243, 249, 255, 0.88) 100%
        );
      box-shadow: 0 24px 60px rgba(2, 10, 32, 0.14);
      padding: 18px;
      display: grid;
      gap: 14px;
    }

    .resHero > * {
      min-width: 0;
    }

    .resHeroCopy {
      min-width: 0;
      max-width: 82ch;
    }

    .resHero .badgeRow {
      justify-content: flex-start;
      margin-bottom: 12px;
    }

    .resHero .lead {
      max-width: 74ch;
    }

    .resHeroSignalRow {
      margin-top: 12px;
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
    }

    .resHeroSignal {
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 10px 26px rgba(2, 10, 32, 0.08);
      padding: 9px 10px;
    }

    .resHeroSignalK {
      color: rgba(17, 24, 39, 0.56);
      font-size: 10px;
      font-weight: 880;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .resHeroSignalV {
      margin-top: 4px;
      color: rgba(7, 20, 48, 0.92);
      font-size: 18px;
      line-height: 1.14;
      letter-spacing: -0.01em;
      font-weight: 830;
    }

    .resHeroSignalT {
      margin-top: 4px;
      color: rgba(17, 24, 39, 0.68);
      font-size: 12px;
      line-height: 1.52;
    }

    .resHeroMedia {
      display: grid;
      gap: 8px;
      align-content: start;
      min-width: 0;
      width: 100%;
    }

    .resVisualShell {
      border: 1px solid rgba(120, 181, 255, 0.34);
      border-radius: 24px;
      overflow: hidden;
      padding: 5px;
      width: 100%;
      max-width: 100%;
      background:
        linear-gradient(145deg, rgba(7, 26, 64, 0.95), rgba(9, 40, 86, 0.92) 56%, rgba(8, 28, 66, 0.94));
      box-shadow: 0 24px 56px rgba(2, 10, 32, 0.28);
    }

    .resVisualShell img {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      border-radius: 18px;
      filter: saturate(1.04) contrast(1.03);
    }

    .resVisualMeta {
      color: rgba(17, 24, 39, 0.58);
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 760;
    }

    .resBand {
      margin-top: 16px;
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }

    .resBandCard {
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 18px;
      background:
        linear-gradient(145deg, rgba(7, 24, 56, 0.96), rgba(9, 39, 86, 0.92) 56%, rgba(8, 27, 62, 0.94));
      box-shadow: 0 18px 40px rgba(2, 10, 32, 0.18);
      padding: 12px 13px;
      color: #eaf5ff;
    }

    .resBandK {
      color: rgba(175, 222, 255, 0.94);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .resBandV {
      margin-top: 7px;
      color: rgba(241, 249, 255, 0.98);
      font-size: 30px;
      line-height: 1.1;
      letter-spacing: -0.03em;
      font-weight: 840;
    }

    .resBandT {
      margin-top: 7px;
      color: rgba(190, 216, 241, 0.9);
      font-size: 13px;
      line-height: 1.58;
    }

    .resBandS {
      margin-top: 4px;
      color: rgba(186, 214, 242, 0.84);
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 780;
    }

    .resCases {
      margin-top: 14px;
      display: grid;
      gap: 10px;
      grid-template-columns: 1fr;
    }

    .resCase {
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.84);
      box-shadow: 0 16px 34px rgba(2, 10, 32, 0.1);
      padding: 13px;
    }

    .resCaseMeta {
      color: rgba(17, 24, 39, 0.56);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .resCase h2 {
      margin-top: 8px;
      font-size: 24px;
      line-height: 1.16;
      letter-spacing: -0.02em;
    }

    .resCaseP {
      margin-top: 8px;
      color: rgba(17, 24, 39, 0.72);
      font-size: 14px;
      line-height: 1.66;
    }

    .resCaseStats {
      margin-top: 10px;
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .resCaseStats div {
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 12px;
      background: rgba(16, 24, 40, 0.03);
      padding: 8px 9px;
      display: grid;
      gap: 2px;
    }

    .resCaseStats strong {
      color: rgba(7, 20, 48, 0.9);
      font-size: 16px;
      line-height: 1.15;
    }

    .resCaseStats span {
      color: rgba(17, 24, 39, 0.58);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 760;
    }

    .resLedger {
      margin-top: 14px;
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.8);
      box-shadow: 0 16px 34px rgba(2, 10, 32, 0.09);
      padding: 14px;
    }

    .resLedgerKicker {
      display: inline-flex;
      border: 1px solid rgba(11, 31, 66, 0.14);
      border-radius: 999px;
      background: rgba(16, 24, 40, 0.04);
      color: rgba(7, 20, 48, 0.86);
      padding: 7px 11px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .resLedgerTable {
      margin-top: 10px;
      display: grid;
      gap: 8px;
    }

    .resLedgerRow {
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 14px;
      padding: 10px;
      background: rgba(255, 255, 255, 0.74);
    }

    .resLedgerRowHead {
      background: rgba(16, 24, 40, 0.04);
    }

    .resLedgerCell {
      color: rgba(17, 24, 39, 0.72);
      font-size: 13px;
      line-height: 1.56;
    }

    .resLedgerRowHead .resLedgerCell {
      color: rgba(7, 20, 48, 0.88);
      font-weight: 860;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: 11px;
    }

    .resActions {
      margin-top: 14px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .resReference {
      margin-top: 14px;
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 16px 34px rgba(2, 10, 32, 0.09);
      padding: 14px;
    }

    .resReferenceKicker {
      display: inline-flex;
      border: 1px solid rgba(11, 31, 66, 0.14);
      border-radius: 999px;
      background: rgba(16, 24, 40, 0.04);
      color: rgba(7, 20, 48, 0.86);
      padding: 7px 11px;
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .resReferenceLead {
      margin: 10px 0 0;
      color: rgba(17, 24, 39, 0.7);
      line-height: 1.7;
      font-size: 14px;
      max-width: 88ch;
    }

    .resReferenceGrid {
      margin-top: 12px;
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
    }

    .resReferenceCard {
      border: 1px solid rgba(11, 31, 66, 0.12);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.74);
      padding: 10px;
    }

    .resReferenceLabel {
      color: rgba(17, 24, 39, 0.56);
      font-size: 10px;
      font-weight: 860;
      letter-spacing: 0.11em;
      text-transform: uppercase;
    }

    .resReferenceValue {
      margin-top: 5px;
      color: rgba(7, 20, 48, 0.92);
      font-size: 20px;
      line-height: 1.16;
      letter-spacing: -0.01em;
      font-weight: 840;
    }

    .resReferenceText {
      margin-top: 6px;
      color: rgba(17, 24, 39, 0.68);
      font-size: 13px;
      line-height: 1.58;
    }

    .resReferenceActions {
      margin-top: 12px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    @media (min-width: 980px) {
      .resHero {
        grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
        align-items: start;
        gap: 16px;
      }

      .resHeroSignalRow {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resBand {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resCases {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resReferenceGrid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .resLedgerRow {
        grid-template-columns: 0.9fr 0.9fr 1.2fr;
        align-items: start;
      }
    }

    @media (max-width: 720px) {
      .resHero .badgeRow {
        justify-content: flex-start;
      }
    }
  </style>
</BaseLayout>
