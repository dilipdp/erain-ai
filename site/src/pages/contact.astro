---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact - EraIn AI';
const description =
  'High-signal contact for leaders seeking audit-first clarity, quantified impact, and disciplined execution.';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL ?? '/api/public';
const supportEmail = import.meta.env.PUBLIC_SUPPORT_EMAIL ?? 'hello@erainai.com';
const contactPath = import.meta.env.PUBLIC_CONTACT_API_PATH ?? '/contact';
---

<BaseLayout title={title} description={description}>
  <section class="contactV2">
    <header class="contactHero reveal" aria-label="Contact intro">
      <div class="heroCopy">
        <div class="heroEyebrow">Contact EraIn</div>
        <h1 class="h1 heroTitle">Bring one operating bottleneck. We return one governed recovery path.</h1>
        <p class="lead heroLead">
          This intake is for operators, CXOs, and transformation leaders who need auditability, decision governance,
          and measurable ROI attribution. Share context only. No confidential data is required.
        </p>

        <div class="heroPills" role="list" aria-label="Contact positioning">
          <span class="pill" role="listitem">Audit to execution</span>
          <span class="pill" role="listitem">All industries</span>
          <span class="pill" role="listitem">24h response if fit</span>
          <span class="pill" role="listitem">INR and USD programs</span>
        </div>
      </div>

      <aside class="heroMeta" aria-label="Qualification signals">
        <article class="metaCard">
          <div class="metaK">Best fit</div>
          <div class="metaV">Execution leakage or decision bottlenecks</div>
        </article>
        <article class="metaCard">
          <div class="metaK">Expected output</div>
          <div class="metaV">Owner-mapped recovery plan with governance cadence</div>
        </article>
        <article class="metaCard">
          <div class="metaK">Response model</div>
          <div class="metaV">Qualification, priority, and next-step recommendation</div>
        </article>
      </aside>
    </header>

    <div class="contactGrid reveal">
      <aside class="infoRail" aria-label="Contact notes">
        <article class="panel">
          <div class="panelK">Before you submit</div>
          <ul>
            <li>We start from current reality: ERP, Excel, Tally, SOPs, and operator signals.</li>
            <li>Audit focus: margin leakage, throughput loss, and decision drift.</li>
            <li>Execution is scoped only after impact and owner path are clear.</li>
            <li>If aligned, you receive a response within 24 hours.</li>
          </ul>
        </article>

        <article class="panel panelSoft">
          <div class="panelK">Direct channel</div>
          <div class="kv">
            <div><span>Email</span><strong>{supportEmail}</strong></div>
            <div><span>Review window</span><strong>&lt; 24h (if fit)</strong></div>
          </div>
          <p class="panelHint">
            References:
            <a href="/results" data-track="contact_results_link">Results</a>
            <span aria-hidden="true"> / </span>
            <a href="/pricing" data-track="contact_pricing_link">Pricing</a>
          </p>
        </article>

        <article class="panel panelPro">
          <div class="panelK">Existing audit upgrade</div>
          <p>
            If upgrading from a Free Audit, include your request ID for faster routing.
            You can open this page with <code>?upgrade=pro&amp;request_id=AR-...</code>.
          </p>
        </article>
      </aside>

      <section class="formPane" aria-label="Contact form">
        <article class="panel panelForm">
          <h2 class="h2">Send message</h2>
          <p class="formLead">We process high-signal requests first and reply with a practical next step.</p>

          <form
            id="contactForm"
            class="form"
            data-api-base={apiBase}
            data-support-email={supportEmail}
            data-contact-path={contactPath}
            novalidate
          >
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-label="Leave this field empty" />

            <div class="field">
              <label for="intent">What do you need?</label>
              <select id="intent" name="intent" required>
                <option value="general_inquiry">General inquiry</option>
                <option value="free_audit">Request Free Audit</option>
                <option value="pro_audit">Request Pro Audit</option>
                <option value="upgrade_existing">Upgrade existing audit</option>
                <option value="deploy_ops">Deploy EraIn in operations</option>
              </select>
            </div>

            <div class="row2">
              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" required placeholder="Your name" autocomplete="name" />
              </div>
              <div class="field">
                <label for="phone">Phone (optional)</label>
                <input id="phone" name="phone" placeholder="+91..." inputmode="tel" autocomplete="tel" />
              </div>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required placeholder="you@company.com" autocomplete="email" />
            </div>

            <div class="row2">
              <div class="field">
                <label for="company">Company</label>
                <input id="company" name="company" placeholder="Company name" autocomplete="organization" />
              </div>
              <div class="field">
                <label for="request_id">Request ID (if any)</label>
                <input id="request_id" name="request_id" placeholder="AR-..." />
              </div>
            </div>

            <div class="field">
              <label for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="7"
                required
                placeholder="What outcome are you targeting? Where is value leaking now?"
              ></textarea>
              <p class="help">Share context, not confidential data.</p>
            </div>

            <div class="actions">
              <button id="contactSubmitBtn" class="btnPrimary" type="submit">
                <span id="contactBtnText">Send message</span>
                <span id="contactSpinner" class="hidden" aria-hidden="true">...</span>
              </button>
              <p class="help">Secure submit. No email app required.</p>
            </div>

            <div id="contactStatus" class="status hidden" aria-live="polite"></div>
          </form>
        </article>
      </section>
    </div>
  </section>

  <style>
    .contactV2 {
      max-width: 1320px;
      margin: 0 auto;
      display: grid;
      gap: 22px;
      padding-bottom: 24px;
    }

    .contactHero,
    .panel {
      border: 1px solid rgba(15, 23, 42, 0.11);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 18px 44px rgba(2, 10, 32, 0.08);
      padding: clamp(18px, 3.2vw, 30px);
    }

    .contactHero {
      display: grid;
      gap: 14px;
      align-items: start;
    }

    .heroEyebrow {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(15, 23, 42, 0.16);
      border-radius: 999px;
      padding: 8px 14px;
      color: rgba(15, 23, 42, 0.72);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      background: rgba(255, 255, 255, 0.72);
    }

    .heroTitle {
      margin-top: 14px;
      max-width: 16ch;
      font-size: clamp(40px, 7.2vw, 74px);
      line-height: 0.96;
      letter-spacing: -0.05em;
      font-weight: 860;
    }

    .heroLead {
      margin-top: 14px;
      max-width: 68ch;
      font-size: clamp(17px, 1.9vw, 21px);
      line-height: 1.58;
      color: rgba(15, 23, 42, 0.7);
    }

    .heroPills {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(15, 23, 42, 0.14);
      border-radius: 999px;
      padding: 7px 11px;
      font-size: 12px;
      font-weight: 760;
      color: rgba(15, 23, 42, 0.72);
      background: rgba(255, 255, 255, 0.68);
    }

    .heroMeta {
      display: grid;
      gap: 8px;
      grid-template-columns: 1fr;
    }

    .metaCard {
      border: 1px solid rgba(15, 23, 42, 0.12);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.72);
      padding: 12px 14px;
    }

    .metaK {
      font-size: 10px;
      font-weight: 860;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.56);
    }

    .metaV {
      margin-top: 6px;
      color: rgba(15, 23, 42, 0.9);
      font-size: 15px;
      line-height: 1.45;
      font-weight: 730;
    }

    .contactGrid {
      display: grid;
      gap: 16px;
      grid-template-columns: 1fr;
      align-items: start;
    }

    .infoRail,
    .formPane {
      min-width: 0;
      display: grid;
      gap: 12px;
    }

    .panelK {
      font-size: 10px;
      font-weight: 860;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.56);
    }

    .panel ul {
      margin: 10px 0 0;
      padding-left: 18px;
      color: rgba(15, 23, 42, 0.76);
      font-size: 14px;
      line-height: 1.6;
      display: grid;
      gap: 6px;
    }

    .panelSoft {
      background: rgba(255, 255, 255, 0.74);
    }

    .panelPro {
      border-color: rgba(36, 90, 223, 0.22);
      background: rgba(36, 90, 223, 0.08);
    }

    .panelPro p,
    .panelHint,
    .panel p,
    .formLead,
    .help {
      color: rgba(15, 23, 42, 0.66);
      font-size: 14px;
      line-height: 1.58;
      margin: 8px 0 0;
    }

    .kv {
      margin-top: 10px;
      display: grid;
      gap: 10px;
    }

    .kv div {
      display: grid;
      gap: 2px;
    }

    .kv span {
      color: rgba(15, 23, 42, 0.56);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .kv strong {
      color: rgba(15, 23, 42, 0.9);
      font-size: 15px;
      letter-spacing: -0.01em;
    }

    .panelHint a {
      color: #1f4dc4;
      font-weight: 700;
    }

    .panelForm {
      border-radius: 24px;
    }

    .form {
      margin-top: 14px;
      display: grid;
      gap: 14px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .row2 {
      display: grid;
      gap: 14px;
      grid-template-columns: 1fr;
    }

    label {
      color: rgba(15, 23, 42, 0.74);
      font-size: 13px;
      font-weight: 760;
    }

    input,
    select,
    textarea {
      border: 1px solid rgba(15, 23, 42, 0.16);
      border-radius: 14px;
      padding: 12px 14px;
      font-size: 14px;
      background: rgba(255, 255, 255, 0.95);
      color: rgba(15, 23, 42, 0.9);
    }

    textarea {
      resize: vertical;
      min-height: 160px;
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: none;
      border-color: rgba(36, 90, 223, 0.4);
      box-shadow: 0 0 0 3px rgba(36, 90, 223, 0.12);
    }

    .actions {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 4px;
    }

    .btnPrimary {
      border-radius: 14px;
      padding: 12px 20px;
      font-weight: 800;
      background: linear-gradient(135deg, #245adf 0%, #0a8cb8 100%);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.28);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 16px 30px rgba(36, 90, 223, 0.24);
      transition: transform 140ms ease, box-shadow 140ms ease;
    }

    .btnPrimary:hover {
      transform: translateY(-1px);
      box-shadow: 0 20px 36px rgba(36, 90, 223, 0.28);
    }

    .btnPrimary:disabled {
      opacity: 0.66;
      cursor: not-allowed;
    }

    .status {
      margin-top: 6px;
      padding: 12px 14px;
      border-radius: 14px;
      border: 1px solid rgba(15, 23, 42, 0.12);
      font-size: 13px;
      line-height: 1.6;
      background: rgba(255, 255, 255, 0.9);
      color: #111827;
    }

    .status.info {
      border-color: rgba(59, 130, 246, 0.26);
      background: rgba(59, 130, 246, 0.08);
      color: #1e3a8a;
    }

    .status.success {
      border-color: rgba(16, 185, 129, 0.3);
      background: rgba(16, 185, 129, 0.09);
      color: #065f46;
    }

    .status.error {
      border-color: rgba(239, 68, 68, 0.3);
      background: rgba(239, 68, 68, 0.08);
      color: #991b1b;
    }

    .hidden {
      display: none !important;
    }

    input[name='company_website'] {
      position: absolute !important;
      left: -9999px !important;
      top: auto !important;
      width: 1px !important;
      height: 1px !important;
      overflow: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    @media (min-width: 800px) {
      .row2 {
        grid-template-columns: 1fr 1fr;
      }

      .heroMeta {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (min-width: 1080px) {
      .contactGrid {
        grid-template-columns: 360px minmax(0, 1fr);
      }

      .infoRail {
        position: sticky;
        top: 104px;
      }
    }

    @media (max-width: 768px) {
      .contactHero,
      .panel {
        border-radius: 22px;
        padding: 16px;
      }

      .heroTitle {
        max-width: 12ch;
      }

      .actions .btnPrimary {
        width: 100%;
        justify-content: center;
      }
    }
  </style>

  <script>
    (function () {
      const form = document.getElementById('contactForm');
      if (!(form instanceof HTMLFormElement)) return;

      const statusEl = document.getElementById('contactStatus');
      const submitBtn = document.getElementById('contactSubmitBtn');
      const btnText = document.getElementById('contactBtnText');
      const spinner = document.getElementById('contactSpinner');
      const intentSelect = document.getElementById('intent');
      const requestIdInput = document.getElementById('request_id');

      const loopbackHosts = new Set(['127.0.0.1', 'localhost']);
      const apiBaseRaw = (form.dataset.apiBase || '').trim();
      let apiBase = apiBaseRaw.replace(/\/$/, '');
      if (!apiBase) apiBase = '/api/public';
      try {
        const parsed = new URL(apiBase, window.location.origin);
        if (loopbackHosts.has(parsed.hostname) && !loopbackHosts.has(window.location.hostname)) {
          apiBase = '/api/public';
        }
      } catch (_) {}
      const supportEmail = (form.dataset.supportEmail || 'hello@erainai.com').trim();
      const configuredPath = (form.dataset.contactPath || '/contact').trim();
      const normalizedConfiguredPath = configuredPath.startsWith('/') ? configuredPath : `/${configuredPath}`;
      const contactPaths = [...new Set([normalizedConfiguredPath, '/contact', '/contact/submit', '/inquiries'])];

      function setLoading(isLoading) {
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = isLoading;
        if (btnText) btnText.textContent = isLoading ? 'Sending...' : 'Send message';
        if (spinner) spinner.classList.toggle('hidden', !isLoading);
      }

      function setStatus(type, message) {
        if (!statusEl) return;
        statusEl.classList.remove('hidden', 'info', 'success', 'error');
        statusEl.classList.add(type);
        statusEl.textContent = message;
      }

      function emitAnalytics(eventName, payload = {}) {
        const eventPayload = {
          page_path: window.location.pathname,
          ...payload,
        };

        try {
          if (typeof window.erainTrack === 'function') {
            window.erainTrack(eventName, eventPayload);
            return;
          }
        } catch (_) {}

        if (window.erainAnalyticsEnabled === false) return;

        if (window.gtag) {
          window.gtag('event', eventName, eventPayload);
        }

        try {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: eventName, ...eventPayload });
        } catch (_) {}
      }

      try {
        const params = new URLSearchParams(window.location.search);
        if (params.get('upgrade') === 'pro' && intentSelect instanceof HTMLSelectElement) {
          intentSelect.value = 'upgrade_existing';
        }
        const requestId = params.get('request_id');
        if (requestId && requestIdInput instanceof HTMLInputElement) {
          requestIdInput.value = requestId;
        }
      } catch (_) {}

      if (!apiBase) {
        if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
        setStatus('error', `Contact service is temporarily unavailable. Please email ${supportEmail}.`);
        return;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = Object.fromEntries(new FormData(form).entries());
        if (formData.company_website) {
          setStatus('error', 'Submission blocked.');
          return;
        }

        const message = String(formData.message || '').trim();
        if (!message) {
          setStatus('error', 'Please add a short message before submitting.');
          return;
        }

        const payload = {
          intent: String(formData.intent || 'general_inquiry'),
          contact: {
            name: String(formData.name || '').trim(),
            email: String(formData.email || '').trim(),
            phone: String(formData.phone || '').trim(),
          },
          company: String(formData.company || '').trim(),
          request_id: String(formData.request_id || '').trim() || null,
          message,
          source: 'website_contact',
          submitted_at_utc: new Date().toISOString(),
          page: window.location.pathname,
        };

        if (!payload.contact.name || !payload.contact.email) {
          setStatus('error', 'Name and email are required.');
          return;
        }

        setLoading(true);
        setStatus('info', 'Sending your message...');

        try {
          let successPayload = null;
          let submitted = false;
          let lastError = '';

          for (const path of contactPaths) {
            try {
              const response = await fetch(`${apiBase}${path}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
              });

              if (response.status === 404) {
                continue;
              }

              if (!response.ok) {
                lastError = await response.text().catch(() => '');
                break;
              }

              successPayload = await response.json().catch(() => null);
              submitted = true;
              break;
            } catch (error) {
              lastError = error instanceof Error ? error.message : String(error);
            }
          }

          if (!submitted) {
            throw new Error(lastError || 'Unable to submit contact request.');
          }

          const reference = successPayload?.request_id || successPayload?.id || successPayload?.reference_id || null;
          if (reference) {
            setStatus('success', `Message sent. Reference: ${reference}. Our team will contact you shortly.`);
          } else {
            setStatus('success', 'Message sent. Our team will contact you shortly.');
          }

          emitAnalytics('contact_submitted', {
            intent: payload.intent,
            has_reference: Boolean(reference),
            has_request_id: Boolean(payload.request_id),
          });

          form.reset();
        } catch (_) {
          setStatus('error', `Could not submit right now. Please email ${supportEmail}.`);
          emitAnalytics('contact_submit_failed', {
            intent: payload.intent,
          });
        } finally {
          setLoading(false);
        }
      });
    })();
  </script>
</BaseLayout>
