---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Developer Docs — EraIn AI" description="Developer docs moved to /developers.">
  <section style="max-width:900px;margin:0 auto;display:grid;gap:14px;">
    <div class="card" style="padding:24px;border:1px solid rgba(11,31,66,.12);border-radius:20px;background:rgba(255,255,255,.9);box-shadow:0 14px 34px rgba(2,10,32,.08);">
      <div class="badgeRow"><span class="badge badgeSoft">Developer Docs</span></div>
      <h1 class="h1">Developer docs are now at <code>/developers</code>.</h1>
      <p class="lead">Use the main docs page for API contracts, auth model, and integration examples.</p>
      <div class="btn-row"><a class="btn btnPrimary" href="/developers">Open Developer Docs</a></div>
    </div>
  </section>
</BaseLayout>
