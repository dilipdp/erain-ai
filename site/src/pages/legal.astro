---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Legal, Governance & Compliance • EraIn AI";
const description =
  "Audit-first governance built for real businesses: privacy-by-design, execution-safe boundaries, and compliance-ready audit trails.";
---

<BaseLayout title={title} description={description}>
  <section class="legal">
    <div class="legalWrap">
        <div class="hero">
      <div class="heroGlow" aria-hidden="true"></div>

      <div class="badgeRow legalBadges">
        <span class="badge badgeSoft">Audit-first</span>
        <span class="badge badgeSoft">Privacy-by-design</span>
        <span class="badge badgeSoft">Execution-safe</span>
      </div>

      <h1 class="h1">Legal, governance & compliance</h1>
      <p class="lead">
        EraIn is built for real businesses operating in regulated and high‑stakes environments — across <strong>all industries</strong> and <strong>all service models</strong> (manufacturing, retail, logistics, EPC, healthcare, finance, public sector, tech, and multi‑site enterprises).
        Our governance is <strong>audit‑first</strong>: it protects privacy, preserves human control, and keeps execution safe — from the first assessment to long‑term operating cadence.
      </p>
      <div class="heroMeta" aria-label="Legal page metadata">
        <div class="heroMetaRow">
          <span class="heroMetaK">Last updated</span>
          <span class="heroMetaV">February 11, 2026</span>
        </div>
        <div class="heroMetaRow">
          <span class="heroMetaK">Note</span>
          <span class="heroMetaV">This page provides general information and is not legal advice.</span>
        </div>
      </div>

      <div class="enterpriseStrip" aria-label="Enterprise compliance highlights">
        <div class="enterpriseItem">
          <div class="enterpriseK">Enterprise-ready</div>
          <div class="enterpriseV">DPA / NDA / addendum support</div>
          <div class="enterpriseS">Contract-ready terms for privacy, retention, access, and audit trails.</div>
        </div>
        <div class="enterpriseItem">
          <div class="enterpriseK">Security baseline</div>
          <div class="enterpriseV">Least-privilege + auditable access</div>
          <div class="enterpriseS">Scoped permissions, logging, segmentation, and client-approved controls.</div>
        </div>
        <div class="enterpriseItem">
          <div class="enterpriseK">Deployment options</div>
          <div class="enterpriseV">Cloud / VPC / on‑prem</div>
          <div class="enterpriseS">Data residency and network isolation options based on your policy.</div>
        </div>
      </div>

      <div class="legalGrid">
      <article class="legalCard">
        <h2 class="h2">Core principles</h2>
        <ul class="list">
          <li><strong>Audit-first:</strong> No execution without verified reality.</li>
          <li><strong>Human control:</strong> Humans retain final authority over actions.</li>
          <li><strong>Refusal-first safety:</strong> Ambiguity triggers refusal, not action.</li>
          <li><strong>Traceability:</strong> Decisions, actions, and outcomes are logged.</li>
        </ul>
      </article>

      <article class="legalCard">
        <h2 class="h2">Data protection & privacy</h2>
        <ul class="list">
          <li>Client data is processed only for the requested assessment or engagement.</li>
          <li>No training on client data without explicit written agreement.</li>
          <li>Access is restricted, logged, and auditable.</li>
          <li>Retention follows contract terms and applicable regulations.</li>
        </ul>
      </article>

      <article class="legalCard">
        <h2 class="h2">AI usage boundaries</h2>
        <ul class="list">
          <li>No autonomous goal formation.</li>
          <li>No irreversible execution without explicit human confirmation.</li>
          <li>No cross-client data leakage.</li>
          <li>No speculative execution on unverified inputs.</li>
        </ul>
      </article>

      <article class="legalCard">
        <h2 class="h2">Compliance readiness</h2>
        <ul class="list">
          <li>Designed to support enterprise audits and internal reviews.</li>
          <li>Clear separation between analysis, recommendation, and execution.</li>
          <li>Alignment with common corporate governance expectations.</li>
          <li>Expandable for jurisdiction-specific legal requirements.</li>
        </ul>
      </article>
    </div>

    <section class="assuranceMatrix" aria-label="Enterprise assurance matrix">
      <div class="assuranceHead">
        <div class="assuranceKicker">Assurance Matrix</div>
        <h2 class="h2">How controls map to operational trust</h2>
      </div>

      <div class="assuranceTable" role="table" aria-label="Assurance controls">
        <div class="assuranceRow assuranceRowHead" role="row">
          <div class="assuranceCell" role="columnheader">Commitment</div>
          <div class="assuranceCell" role="columnheader">Control Pattern</div>
          <div class="assuranceCell" role="columnheader">Client Visibility</div>
        </div>
        <div class="assuranceRow" role="row">
          <div class="assuranceCell" role="cell">Data minimization</div>
          <div class="assuranceCell" role="cell">Least-access intake and scoped processing boundaries.</div>
          <div class="assuranceCell" role="cell">Access scope and retention terms available in engagement records.</div>
        </div>
        <div class="assuranceRow" role="row">
          <div class="assuranceCell" role="cell">Decision governance</div>
          <div class="assuranceCell" role="cell">Owner mapping, approval checkpoints, refusal-first execution safety.</div>
          <div class="assuranceCell" role="cell">Decision path artifacts and owner accountability map.</div>
        </div>
        <div class="assuranceRow" role="row">
          <div class="assuranceCell" role="cell">Outcome auditability</div>
          <div class="assuranceCell" role="cell">Traceable findings, action logs, and attribution-ready output bundles.</div>
          <div class="assuranceCell" role="cell">Evidence-linked reporting and governance-ready summaries.</div>
        </div>
      </div>
    </section>

    <div class="legalStack" aria-label="Detailed governance">
      <article class="legalWide">
        <h2 class="h2">Security & access controls</h2>
        <ul class="list">
          <li><strong>Least privilege:</strong> access is limited to the smallest necessary scope for the engagement.</li>
          <li><strong>Logging:</strong> access and key actions are logged for auditability.</li>
          <li><strong>Segmentation:</strong> project boundaries prevent cross‑client data mixing.</li>
          <li><strong>Secure handling:</strong> credentials and sensitive artifacts are handled using client‑approved controls.</li>
        </ul>
      </article>

      <article class="legalWide">
        <h2 class="h2">Data handling, retention & deletion</h2>
        <ul class="list">
          <li><strong>Purpose limitation:</strong> data is processed only for the requested assessment or engagement.</li>
          <li><strong>Retention:</strong> retention follows the contract and applicable regulations.</li>
          <li><strong>Deletion:</strong> deletion requests are supported per agreed terms and legal requirements.</li>
          <li><strong>No training by default:</strong> we do not train on client data without explicit written agreement.</li>
        </ul>
      </article>

      <article class="legalWide">
        <h2 class="h2">Enterprise compliance pack</h2>
        <p class="muted legalP">
          For enterprise rollouts, we provide a compliance-ready bundle that makes internal reviews faster and reduces legal ambiguity.
        </p>
        <ul class="list">
          <li><strong>DPA / NDA support:</strong> contract-ready privacy and confidentiality terms on request.</li>
          <li><strong>Data residency options:</strong> cloud, VPC, or on‑prem deployment aligned to your policy.</li>
          <li><strong>Sub-processor transparency:</strong> clear disclosure model and engagement-specific controls.</li>
          <li><strong>Incident response:</strong> defined notification paths and remediation expectations per agreement.</li>
          <li><strong>Audit artifacts:</strong> access logs, owner mapping, retention terms, and traceability outputs.</li>
        </ul>
      </article>

      <article class="legalWide">
        <h2 class="h2">Responsible AI boundaries</h2>
        <ul class="list">
          <li><strong>No autonomous goal formation:</strong> EraIn does not invent objectives on its own.</li>
          <li><strong>Human approval for execution:</strong> no irreversible actions without explicit human confirmation.</li>
          <li><strong>Refusal‑first safety:</strong> ambiguity triggers refusal, not action.</li>
          <li><strong>Verified inputs:</strong> we avoid speculative execution on unverified data.</li>
        </ul>
      </article>

      <article class="legalWide">
        <h2 class="h2">Audit trails & governance outputs</h2>
        <p class="muted legalP">
          Enterprise engagements can include contract‑ready addendums and governance artifacts that support internal audits.
          Typical outputs include access logs, decision/action traceability, retention terms, and role/owner mapping.
        </p>

        <div class="legalFaq" aria-label="Governance FAQs">
          <details class="qa" open>
            <summary>Do you train models on our data?</summary>
            <p>No — not unless you explicitly authorize it in writing as part of a separate agreement.</p>
          </details>
          <details class="qa">
            <summary>Can you work with Excel/Tally/ERP and messy data?</summary>
            <p>Yes. We start from what exists today and improve data quality as part of the execution plan.</p>
          </details>
          <details class="qa">
            <summary>What does “audit‑first” mean in practice?</summary>
            <p>We establish verified reality first (baseline), quantify impact, assign owners, and then recommend execution — not the other way around.</p>
          </details>
        </div>
      </article>
    </div>

    <div class="legalCta">
      <div class="card">
        <h2 class="h2">Questions, legal requests, or enterprise addendums</h2>
        <p class="muted">
          Email <a href="mailto:hello@erainai.com">hello@erainai.com</a>. For enterprise engagements, we can share contract‑ready
          addendums for privacy, retention, access controls, and audit trails.
        </p>
        <div class="legalActions" aria-label="Legal actions">
          <a class="btn btnPrimary" href="/contact?topic=legal">Contact us</a>
          <a class="btn" href="/request-assessment">Start Free AI Audit</a>
        </div>
      </div>
    </div>

    <style>
      .legal {
        padding-top: 10px;
      }

      /* Page wrapper (BaseLayout already provides .container; this keeps page width premium) */
      .legalWrap {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 22px;
      }

      /* Hero */
      .hero {
        position: relative;
        max-width: 88ch;
        margin: 0 auto 24px;
        text-align: center;
      }

      .heroGlow {
        position: absolute;
        inset: -120px -80px auto;
        height: 260px;
        pointer-events: none;
        background:
          radial-gradient(720px 240px at 50% 30%, rgba(37, 99, 235, 0.14), transparent 65%),
          radial-gradient(620px 260px at 18% 20%, rgba(15, 23, 42, 0.08), transparent 70%),
          radial-gradient(560px 240px at 84% 10%, rgba(2, 6, 23, 0.05), transparent 70%);
        filter: blur(2px);
        opacity: 0.75;
      }

      .legal .badgeRow {
        margin-bottom: 12px;
      }

      .legalBadges {
        justify-content: center;
      }

      .hero .h1 {
        margin-top: 12px;
      }

      .hero .lead {
        margin-left: auto;
        margin-right: auto;
        max-width: 92ch;
      }

      .heroMeta {
        margin: 14px auto 0;
        max-width: 68ch;
        display: grid;
        gap: 8px;
        text-align: left;
        border: 1px solid rgba(17, 24, 39, 0.10);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.70);
        padding: 10px 12px;
      }

      .heroMetaRow {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 10px;
        align-items: start;
      }

      .heroMetaK {
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(17, 24, 39, 0.58);
        white-space: nowrap;
      }

      .heroMetaV {
        color: rgba(17, 24, 39, 0.74);
        font-size: 13.5px;
        line-height: 1.65;
      }

      .enterpriseStrip {
        margin: 14px auto 0;
        max-width: 92ch;
        display: grid;
        gap: 10px;
        grid-template-columns: 1fr;
        text-align: left;
      }

      @media (min-width: 860px) {
        .enterpriseStrip {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .enterpriseItem {
        border: 1px solid rgba(17, 24, 39, 0.10);
        border-radius: 20px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.90) 0%, rgba(255, 255, 255, 0.70) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 16px 44px rgba(2, 6, 23, 0.08);
        padding: 12px 12px;
      }

      .enterpriseK {
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(17, 24, 39, 0.56);
      }

      .enterpriseV {
        margin-top: 6px;
        font-weight: 950;
        letter-spacing: -0.02em;
        color: rgba(2, 6, 23, 0.88);
        line-height: 1.2;
      }

      .enterpriseS {
        margin-top: 6px;
        font-size: 13px;
        line-height: 1.6;
        color: rgba(17, 24, 39, 0.68);
      }

      /* Shared list */
      .list {
        margin: 12px 0 0;
        padding: 0;
        list-style: none;
        color: rgba(17, 24, 39, 0.72);
        font-size: 15.5px;
        line-height: 1.78;
        display: grid;
        gap: 10px;
      }

      .list li {
        position: relative;
        padding-left: 26px;
      }

      .list li::before {
        content: "✓";
        width: 16px;
        height: 16px;
        border-radius: 999px;
        position: absolute;
        left: 0;
        top: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 900;
        color: rgba(29, 78, 216, 0.98);
        background: rgba(37, 99, 235, 0.10);
        border: 1px solid rgba(37, 99, 235, 0.18);
      }

      /* Top grid */
      .legalGrid {
        margin: 18px auto 0;
        display: grid;
        gap: 18px;
        grid-template-columns: 1fr;
        align-items: stretch;
      }

      @media (min-width: 980px) {
        .legalGrid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .assuranceMatrix {
        margin: 18px auto 0;
        border: 1px solid rgba(11, 31, 66, 0.12);
        border-radius: 24px;
        background:
          linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.93) 0%,
            rgba(245, 250, 255, 0.86) 58%,
            rgba(240, 247, 255, 0.82) 100%
          );
        box-shadow: 0 20px 58px rgba(2, 10, 32, 0.12);
        padding: 16px;
      }

      .assuranceHead {
        max-width: 86ch;
      }

      .assuranceKicker {
        display: inline-flex;
        border: 1px solid rgba(11, 31, 66, 0.14);
        border-radius: 999px;
        background: rgba(16, 24, 40, 0.04);
        color: rgba(7, 20, 48, 0.86);
        padding: 7px 11px;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .assuranceTable {
        margin-top: 12px;
        display: grid;
        gap: 8px;
      }

      .assuranceRow {
        display: grid;
        gap: 8px;
        grid-template-columns: 1fr;
        border: 1px solid rgba(11, 31, 66, 0.12);
        border-radius: 16px;
        padding: 10px;
        background: rgba(255, 255, 255, 0.74);
      }

      .assuranceRowHead {
        background: rgba(16, 24, 40, 0.04);
      }

      .assuranceCell {
        color: rgba(17, 24, 39, 0.72);
        font-size: 13px;
        line-height: 1.56;
      }

      .assuranceRowHead .assuranceCell {
        color: rgba(7, 20, 48, 0.88);
        font-weight: 860;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-size: 11px;
      }

      @media (min-width: 980px) {
        .assuranceRow {
          grid-template-columns: 0.8fr 1fr 1fr;
          align-items: start;
        }
      }

      /* Card base */
      .legalCard,
      .legalWide {
        position: relative;
        border-radius: 24px;
        padding: 20px;
        overflow: hidden;
        border: 1px solid rgba(17, 24, 39, 0.10);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.72) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 18px 50px rgba(2, 6, 23, 0.10);
        transform: translateZ(0);
        transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease, background 160ms ease;
      }

      .legalCard::before,
      .legalWide::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: 24px;
        pointer-events: none;
        background:
          radial-gradient(900px 260px at 50% 0%, rgba(37, 99, 235, 0.08), transparent 60%),
          radial-gradient(720px 260px at 0% 35%, rgba(15, 23, 42, 0.06), transparent 62%);
        opacity: 0.9;
      }

      .legalCard > *,
      .legalWide > * {
        position: relative;
      }

      .legalCard:hover,
      .legalWide:hover {
        transform: translateY(-3px);
        border-color: rgba(17, 24, 39, 0.16);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 26px 78px rgba(2, 6, 23, 0.12);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.78) 100%);
      }

      @media (prefers-reduced-motion: reduce) {
        .legalCard,
        .legalWide {
          transition: none !important;
        }
        .legalCard:hover,
        .legalWide:hover {
          transform: none;
        }
      }

      /* Stack */
      .legalStack {
        margin: 18px auto 0;
        display: grid;
        gap: 18px;
        grid-template-columns: 1fr;
      }

      @media (min-width: 980px) {
        .legalStack {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .legalP {
        margin: 10px 0 0;
        font-size: 14.5px;
        line-height: 1.85;
      }

      .legalFaq {
        margin-top: 12px;
        display: grid;
        gap: 10px;
      }

      /* FAQ (reuse site style, scoped) */
      .legal .qa {
        margin-top: 0;
        border: 1px solid rgba(17, 24, 39, 0.10);
        border-radius: 22px;
        padding: 12px 14px;
        background: rgba(16, 24, 40, 0.03);
        transition: border-color 140ms ease, background 140ms ease;
      }

      .legal .qa:hover {
        border-color: rgba(17, 24, 39, 0.16);
        background: rgba(16, 24, 40, 0.04);
      }

      .legal .qa summary {
        cursor: pointer;
        font-weight: 950;
        color: var(--primary);
        list-style: none;
      }

      .legal .qa summary::-webkit-details-marker {
        display: none;
      }

      .legal .qa summary::after {
        content: "▾";
        float: right;
        color: rgba(17, 24, 39, 0.55);
        transform: translateY(-1px);
      }

      .legal details[open].qa summary::after {
        content: "▴";
      }

      .legal .qa p {
        margin: 10px 0 0;
        color: rgba(17, 24, 39, 0.74);
      }

      /* CTA */
      .legalCta {
        margin-top: 22px;
      }

      .legalCta .card {
        padding: 18px;
      }

      .legalCta .muted {
        margin: 10px 0 0;
        font-size: 14px;
        line-height: 1.85;
      }

      .legalActions {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
      }

      /* Mobile */
      @media (max-width: 520px) {
        .legalWrap {
          padding: 0 16px;
        }

        .hero {
          text-align: left;
          margin-bottom: 18px;
        }

        .legal .badgeRow {
          justify-content: flex-start !important;
        }

        .heroMetaRow {
          grid-template-columns: 1fr;
          gap: 4px;
        }

        .heroMetaK {
          white-space: normal;
        }

        .enterpriseStrip {
          max-width: none;
        }
      }
    </style>
  </section>
</BaseLayout>
