---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Events — EraIn AI";
const description =
  "Live and recorded sessions on AI auditability, decision governance, ROI attribution, and execution discipline.";
---

<BaseLayout title={title} description={description}>
  <section class="eventsPage">
    <header class="card hero">
      <div class="badgeRow">
        <span class="badge badgeSoft">Events</span>
        <span class="badge badgeSoft">Operator-focused</span>
        <span class="badge badgeSoft">No hype, only execution</span>
      </div>
      <h1 class="h1">Events and briefings</h1>
      <p class="lead">
        Sessions for founders, CXOs, and operators who need practical frameworks for AI auditability,
        decision governance, and measurable ROI.
      </p>
    </header>

    <section class="card">
      <h2 class="h2">Upcoming</h2>
      <div class="eventGrid">
        <article class="eventCard">
          <div class="kicker">Web Briefing</div>
          <h3>21-Day Pilot: From Audit to Board Pack</h3>
          <p>Format: 45 minutes. Audience: COO/CFO/Strategy leaders.</p>
          <p>Date: March 12, 2026</p>
        </article>
        <article class="eventCard">
          <div class="kicker">Workshop</div>
          <h3>Decision Governance Map Design Lab</h3>
          <p>Format: 90 minutes. Build owner-path escalation maps live.</p>
          <p>Date: March 19, 2026</p>
        </article>
        <article class="eventCard">
          <div class="kicker">Case Session</div>
          <h3>Proof-Led Conversion: Reference Calls that Close</h3>
          <p>Format: 60 minutes. Commercial operators and founders.</p>
          <p>Date: March 26, 2026</p>
        </article>
      </div>
      <div class="btn-row" style="margin-top:12px">
        <a class="btn btnPrimary" href="/contact?topic=events">Request Invite</a>
      </div>
    </section>

    <section class="card">
      <h2 class="h2">Recorded Sessions</h2>
      <ul>
        <li>Execution leakage diagnostics for multi-site teams.</li>
        <li>Governed decision paths: reducing approval cycle time.</li>
        <li>ROI attribution ledgers: proving impact to leadership.</li>
      </ul>
      <p class="muted">Recorded access is shared with qualified prospects and clients.</p>
    </section>
  </section>

  <style>
    .eventsPage { display: grid; gap: 18px; }
    .card { padding: 20px; border: 1px solid rgba(11,31,66,.12); border-radius: 20px; background: rgba(255,255,255,.9); box-shadow: 0 14px 34px rgba(2,10,32,.08); }
    .hero { padding: 24px; }
    .eventGrid { display: grid; gap: 12px; grid-template-columns: 1fr; }
    .eventCard { border: 1px solid rgba(11,31,66,.12); border-radius: 14px; padding: 14px; background: rgba(255,255,255,.76); }
    ul { margin: 10px 0 0; padding-left: 18px; line-height: 1.7; color: rgba(17,24,39,.82); }
    p { color: rgba(17,24,39,.82); }
    @media (min-width: 960px) { .eventGrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  </style>
</BaseLayout>
